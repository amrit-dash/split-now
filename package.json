{
  "name": "split-now",
  "private": true,
  "version": "3.1.1",
  "description": "Spending is wise, Splitting is Free. Split Now! Free, open-source expense splitting with bill scanning, live table splits, UPI settle-ups and optional AI.",
  "license": "MIT",
  "author": "Amrit Dash",
  "homepage": "https://split-now.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/amrit-dash/split-now.git"
  },
  "bugs": {
    "url": "https://github.com/amrit-dash/split-now/issues"
  },
  "keywords": [
    "splitwise-alternative",
    "expense-splitting",
    "pwa",
    "react",
    "firebase",
    "upi",
    "bill-splitting",
    "ocr",
    "gemini"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc -b",
    "typecheck:all": "tsc -b && tsc -p tsconfig.tooling.json && npm --prefix functions run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-splitit \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only firestore --project demo-splitit \"firebase emulators:exec --only functions --project demo-splitit 'vitest run --config vitest.functions.config.ts'\"",
    "test:all": "npm run lint && npm run typecheck:all && npm test && npm run test:rules && npm run test:functions",
    "icons": "node scripts/generate-icons.mjs",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "firebase-tools": "^15.32.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
