{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!public", "!functions/lib", "!playwright-report", "!test-results", "!**/*.tsbuildinfo"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "asNeeded", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "json": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "html": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "useJsxKeyInIterable": "error",
        "noReactPropAssignments": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useIterableCallbackReturn": "warn",
        "noConsole": "off"
      },
      "style": {
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noParameterAssign": "off"
      },
      "complexity": { "noForEach": "off", "noCommaOperator": "off" },
      "a11y": {
        "useButtonType": "warn",
        "noLabelWithoutControl": "warn",
        "useSemanticElements": "off",
        "noAutofocus": "off",
        "noSvgWithoutTitle": "off",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "useFocusableInteractive": "warn",
        "useKeyWithClickEvents": "warn",
        "useKeyWithMouseEvents": "warn",
        "noStaticElementInteractions": "warn"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["tests/**", "e2e/**", "functions/test/**", "**/*.test.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" }, "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
