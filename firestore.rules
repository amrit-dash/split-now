rules_version = '2';

// Split Now — Firestore security rules.
// Model: a user can see a group only if their uid is in group.memberUids.
// Anonymous accounts (live-table guests) are not users: they can read a table they have the
// code for, and the shared exchange rates, and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A real account (Google / email): anonymous sign-in only exists for live tables.
    function isUser() { return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'; }
    function uid() { return request.auth.uid; }
    // admins/{uid}: created by hand in the Firebase console or by the adminSetAdmin callable; no client can write it.
    function isAdmin() { return isUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function groupDoc(groupId) { return get(/databases/$(database)/documents/groups/$(groupId)); }
    // A group's "Needs your OK" threshold in minor units: its own, else its currency's default.
    // The same table as src/lib/approval.ts APPROVAL_DEFAULTS (a unit test keeps them equal);
    // other currencies get the flat fallback.
    function approvalThresholdOf(g) {
      return g.get('approvalThreshold', {'INR': 200000, 'USD': 10000, 'EUR': 10000, 'GBP': 10000, 'AUD': 10000, 'NZD': 10000, 'CAD': 10000,
        'SGD': 10000, 'CHF': 10000, 'AED': 30000, 'THB': 200000, 'MYR': 30000, 'LKR': 1000000, 'NPR': 300000, 'JPY': 10000, 'KRW': 100000,
        'IDR': 100000000, 'HKD': 50000, 'CNY': 50000, 'PHP': 500000, 'VND': 2000000, 'ZAR': 100000, 'SEK': 100000, 'NOK': 100000,
        'DKK': 50000}.get(g.currency, 10000));
    }
    // Whether an expense of `amount` in this group must be approved (strictly above the threshold).
    function approvalNeeded(g, amount) {
      return g.get('requireApproval', false) == true && amount > approvalThresholdOf(g);
    }
    function isGroupMember(groupId) { return isUser() && uid() in groupDoc(groupId).data.memberUids; }
    // Nothing is added or edited inside a group in Recently deleted (shared/group-trash.ts); deletes
    // still go through, so the creator's "Delete forever" and the purge work. A write in the same
    // batch as the delete or the restore itself passes (live on one side of it).
    // Nothing in Recently deleted can be deleted for good in its first 7 days (shared/group-trash.ts
    // PURGE_HOLD_DAYS), so a delete always leaves the others time to see it and restore it.
    function purgeHeld(deletedAt) {
      return request.time.toMillis() - deletedAt < 604800000;
    }

    function groupLive(groupId) {
      return !('deletedAt' in groupDoc(groupId).data) || !('deletedAt' in getAfter(/databases/$(database)/documents/groups/$(groupId)).data);
    }
    // State of the group once the current write (or batch) is applied.
    function groupAfter(groupId) { return getAfter(/databases/$(database)/documents/groups/$(groupId)); }

    // Maintenance mode (config/app.maintenance, set in the admin console) and blocked accounts
    // (blocked/{uid}, written by the adminBlockUser callable) stop every write except an
    // admin's. Two small reads per write, both cached per request; the admin check only runs
    // when one of them says no.
    function maintenanceOn() {
      let p = /databases/$(database)/documents/config/app;
      return exists(p) && get(p).data.get('maintenance', false) == true;
    }
    function isBlocked() { return exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function writesOpen() { return (!maintenanceOn() && !isBlocked()) || isAdmin(); }

    // ---- Users ---------------------------------------------------------
    // Private profile (email, default currency, payment handles). Owner only.
    // What co-members may see (name + payment handles) is copied by the owner into
    // groups/{groupId}/profiles/{uid}, readable only by that group's members.
    match /users/{userId} {
      // Legacy, unused: approvalDefault and editAutoApproveDefault were personal defaults for
      // new groups' approval settings (approval is now purely a group setting). Still validated,
      // each { on, amount (minor units of currency), currency }, so old documents stay valid.
      function validAmountSetting(p, field) {
        return !(field in p) || (
          p[field] is map
          && p[field].keys().hasAll(['on', 'amount', 'currency'])
          && p[field].keys().hasOnly(['on', 'amount', 'currency'])
          && p[field].on is bool
          && p[field].amount is int
          && p[field].amount > 0 && p[field].amount <= 100000000000
          && p[field].currency is string && p[field].currency.size() == 3);
      }
      function validApprovalDefault(p) {
        return validAmountSetting(p, 'approvalDefault') && validAmountSetting(p, 'editAutoApproveDefault');
      }

      // Pro (src/lib/pro.ts): proAt is when Help reached 100% (epoch ms), set by the app once and
      // never changed or removed after; proHidden / devHidden are "Show my Pro / Dev badge" turned
      // off. Cosmetic: the app sets them itself and nothing checks Help on the server, so these only
      // keep the shape (the Dev badge itself is checked where it is shared: member entries, profiles).
      function validPro(p) {
        return (!('proAt' in p) || (p.proAt is int && p.proAt > 0))
          && (!('proHidden' in p) || p.proHidden is bool)
          && (!('devHidden' in p) || p.devHidden is bool)
          && (resource == null || !('proAt' in resource.data) || p.get('proAt', null) == resource.data.proAt);
      }

      allow get: if isUser() && uid() == userId;
      allow list: if false;
      allow create, update: if isUser() && uid() == userId
        && request.resource.data.uid == userId
        && writesOpen()
        && validApprovalDefault(request.resource.data)
        && validPro(request.resource.data)
        // The first time this account held + for voice (epoch ms): the app stops teaching it (src/lib/voice-teach.ts)
        && request.resource.data.get('voiceTried', 0) is int;
      allow delete: if isUser() && uid() == userId;

      // Captured transactions waiting to be sorted into a group: private to the user.
      // The user's own Gemini key: written and read only by Cloud Functions (aiKey), never by the app.
      match /secrets/{id} {
        allow read, write: if false;
      }
      // The emails this account added with a code (account/emails: { list: { [sha256]: { email, addedAt } } }).
      // Written only by Cloud Functions (confirmEmailCode, removeEmail, mergeAccount); the owner reads it.
      match /account/{id} {
        allow read: if isUser() && uid() == userId;
        allow write: if false;
      }
      // Server-written AI status (key hint, last error); the owner can read it.
      match /aiState/{id} {
        allow read: if isUser() && uid() == userId;
        allow write: if false;
      }

      match /captures/{captureId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.status in ['pending', 'assigned', 'dismissed'];
      }

      // FCM Web Push registrations, one per browser (doc id = hash of the token). Owner only;
      // Cloud Functions read them (Admin SDK) to send and delete dead ones.
      match /pushTokens/{tokenId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && request.resource.data.keys().hasOnly(['token', 'ua', 'createdAt', 'lastSeen'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 300))
          && request.resource.data.createdAt is int
          && request.resource.data.lastSeen is int;
      }

      // What the capture webhook did with each request (result, amount, merchant; never SMS
      // text). Written only by the Cloud Function (Admin SDK); the owner may read and clear it.
      match /captureLog/{entryId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if false;
      }

      // Per-user settings. settings/notifications holds push preferences and auto-capture
      // settings (outsideTrips, capturePaused, minAmount, ignoreWords, pausedTrips) and AI reading (aiSms, aiImages).
      match /settings/{settingId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && (settingId != 'notifications' || (
            request.resource.data.keys().hasOnly(['captures', 'unsorted', 'expenses', 'settlements', 'reminders', 'chat', 'openItems', 'approvals', 'mutedChats', 'outsideTrips',
              'capturePaused', 'minAmount', 'ignoreWords', 'pausedTrips', 'aiSms', 'aiSmsMerchant', 'aiImages', 'aiQuickAdd', 'aiPayments', 'aiIcons', 'aiIconAuto', 'aiEnabled', 'aiSource', 'aiModel', 'aiPictureModel', 'aiFreeOk', 'aiTranscribe', 'aiTranscribeKey', 'updatedAt'])
            && request.resource.data.get('captures', true) is bool
            && request.resource.data.get('unsorted', false) is bool
            && request.resource.data.get('expenses', true) is bool
            && request.resource.data.get('settlements', true) is bool
            && request.resource.data.get('reminders', true) is bool
            // Group chat pushes, and the groups whose chat this person muted (their own choice)
            && request.resource.data.get('chat', true) is bool
            && request.resource.data.get('mutedChats', []) is list
            && request.resource.data.get('mutedChats', []).size() <= 200
            // "Did you pay for this?" when someone names you on an open item
            && request.resource.data.get('openItems', true) is bool
            // "Needs your OK": an expense or a payment waits for this person's approval (functions/src/lib/approval-push.ts)
            && request.resource.data.get('approvals', true) is bool
            && request.resource.data.get('outsideTrips', false) is bool
            // Auto-capture filters (shared/capture-filters.ts; the webhook re-normalises them)
            && request.resource.data.get('capturePaused', false) is bool
            && request.resource.data.get('minAmount', 0) is int
            && request.resource.data.get('minAmount', 0) >= 0 && request.resource.data.get('minAmount', 0) <= 10000000
            && request.resource.data.get('ignoreWords', []) is list
            && request.resource.data.get('ignoreWords', []).size() <= 20
            // Trips this person paused capture for (group ids; their own choice, not the group's)
            && request.resource.data.get('pausedTrips', []) is list
            && request.resource.data.get('pausedTrips', []).size() <= 100
            // AI reading (Gemini) of SMS and images; on unless turned off
            && request.resource.data.get('aiSms', true) is bool
            && request.resource.data.get('aiSmsMerchant', false) is bool
            && request.resource.data.get('aiImages', true) is bool
            // Quick add lines too complex to read go to Gemini (quickAddAi); opt-in
            && request.resource.data.get('aiQuickAdd', false) is bool
            // Payment screenshots clear payments to this person that need their OK; on unless turned off
            && request.resource.data.get('aiPayments', true) is bool
            // "Suggest with AI" in the icon sheet (iconsAi); on unless turned off
            && request.resource.data.get('aiIcons', true) is bool
            // the automatic icon asks AI when the app's own rules find none (iconPickAi); on unless turned off
            && request.resource.data.get('aiIconAuto', true) is bool
            && request.resource.data.get('aiEnabled', true) is bool
            && request.resource.data.get('aiSource', 'auto') in ['auto', 'own', 'app']
            && request.resource.data.get('aiModel', '') is string && request.resource.data.get('aiModel', '').size() <= 80
            // the image model for Draw a picture on the person's own key; '' = recommended
            && request.resource.data.get('aiPictureModel', '') is string && request.resource.data.get('aiPictureModel', '').size() <= 80
            // Agreed to Split Now's free AI (Gemma, Google's unpaid terms); off until they turn it on
            && request.resource.data.get('aiFreeOk', false) is bool
            // Voice heard by AI instead of the phone (transcribeAi); opt-in. Which key it uses (shared/transcribe.ts planTranscribe)
            && request.resource.data.get('aiTranscribe', false) is bool
            && request.resource.data.get('aiTranscribeKey', 'auto') in ['auto', 'own', 'app']
            && request.resource.data.get('updatedAt', 0) is int))
          // settings/merchants: merchant → category memory (src/lib/merchants.ts). Two maps keyed by
          // the normalised merchant, at most 200 entries each; the app evicts the least recently used.
          && (settingId != 'merchants' || (
            request.resource.data.keys().hasOnly(['categories', 'touched', 'updatedAt'])
            && request.resource.data.categories is map && request.resource.data.categories.size() <= 200
            && request.resource.data.get('touched', {}) is map && request.resource.data.get('touched', {}).size() <= 200
            && request.resource.data.get('updatedAt', 0) is int))
          // settings/appearance: theme, accent, animations, detail level, icon style and mode, so they follow the account
          // (src/lib/appearance-sync.ts). Small maps only; values are re-checked on read.
          && (settingId != 'appearance' || (
            request.resource.data.keys().hasOnly(['theme', 'accent', 'duo', 'inks', 'motion', 'look', 'icons', 'mode', 'updatedAt'])
            // The person's own detail level; 'app' follows config/app.look (src/lib/look.ts)
            && request.resource.data.get('look', 'app') in ['app', 'full', 'needed', 'minimal', 'tooltip']
            // The person's own icon style; 'app' follows config/app.icons (src/lib/icon-style.ts)
            && request.resource.data.get('icons', 'app') in ['app', 'outline', 'filled']
            // Simple or Advanced; 'auto' until the person picks (src/lib/mode.ts)
            && request.resource.data.get('mode', 'auto') in ['auto', 'simple', 'advanced']
            && request.resource.data.get('theme', 'system') in ['system', 'light', 'dark']
            && request.resource.data.get('accent', '') is string && request.resource.data.get('accent', '').size() <= 20
            && request.resource.data.get('duo', true) is bool
            && request.resource.data.get('inks', {}) is map && request.resource.data.get('inks', {}).size() <= 20
            && request.resource.data.get('motion', {}) is map && request.resource.data.get('motion', {}).size() <= 20
            && request.resource.data.updatedAt is int))
          // settings/help: the Help sections this person finished (src/lib/help-progress.ts). Only
          // fills their own progress ring; Pro is a separate profile field.
          && (settingId != 'help' || (
            request.resource.data.keys().hasOnly(['done', 'updatedAt'])
            && request.resource.data.done is list && request.resource.data.done.size() <= 200
            && request.resource.data.get('updatedAt', 0) is int))
          // settings/inbox: what this person cleared from Inbox → Updates (src/lib/inbox.ts). Only
          // hides entries for them; the groups' activity itself is never touched.
          && (settingId != 'inbox' || (
            request.resource.data.keys().hasOnly(['clearedAt', 'hidden', 'updatedAt'])
            && request.resource.data.get('clearedAt', 0) is int
            && request.resource.data.get('hidden', []) is list && request.resource.data.get('hidden', []).size() <= 200
            && request.resource.data.get('updatedAt', 0) is int));
      }
    }

    // ---- Server-only state (Cloud Functions, Admin SDK) ----------------
    // rateLimits/{tokenHash}: capture webhook counters. reminderState/{groupId}: when each
    // member was last nudged to settle up. chatPush/{groupId}: when each member last got a loud
    // chat push (functions/src/chat.ts). No client access at all.
    match /chatPush/{id} {
      allow read, write: if false;
    }
    match /rateLimits/{id} {
      allow read, write: if false;
    }
    match /reminderState/{id} {
      allow read, write: if false;
    }
    // A private group's data key, sealed with VAULT_KEK, and its pattern hash and wrong tries
    // (functions/src/vault.ts). Only the vault callable reads or writes it; no client ever can.
    match /vaultKeys/{id} {
      allow read, write: if false;
    }
    // Errors from people's phones for the admin's Logs tab (src/lib/app-errors.ts): a signed-in
    // person files one as themselves, about now, with short fields only; nobody edits one; only
    // admins read them; the daily cleanup removes them after config/limits appErrorKeepDays.
    match /appErrors/{id} {
      allow read: if isAdmin();
      allow create: if isUser()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'kind', 'message', 'stack', 'route', 'version', 'ua', 'mode'])
        && request.resource.data.uid == uid()
        && request.resource.data.at is int
        && request.resource.data.at > request.time.toMillis() - 600000
        && request.resource.data.at < request.time.toMillis() + 300000
        && request.resource.data.kind in ['crash', 'unhandled', 'save', 'voice', 'layout']
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.get('stack', '') is string && request.resource.data.get('stack', '').size() <= 3000
        && request.resource.data.get('route', '') is string && request.resource.data.get('route', '').size() <= 200
        && request.resource.data.get('version', '') is string && request.resource.data.get('version', '').size() <= 40
        && request.resource.data.get('ua', '') is string && request.resource.data.get('ua', '').size() <= 300
        && request.resource.data.get('mode', '') is string && request.resource.data.get('mode', '').size() <= 20;
      allow update, delete: if false;
    }
    // Merges waiting for this person's OK, across their groups (Inbox → To sort): a collection
    // group query on approverUid. The group's own members read them under groups/{gid} too.
    match /{path=**}/mergeRequests/{requestId} {
      allow read: if isUser() && resource.data.approverUid == uid();
    }
    // pendingMerges/{uid}: an address this person just proved with Firebase's sign-in link that has
    // its own account, waiting for "Merge accounts". emailIndex/{sha256(email)}: which account an
    // added email belongs to. Both written by functions/src/accounts.ts.
    match /pendingMerges/{id} {
      allow read, write: if false;
    }
    match /emailIndex/{id} {
      allow read, write: if false;
    }

    // ---- Admin-managed configuration (config/*, admins/*, blocked/*, stats/*) ----------
    // config/app: the app's public switches (maintenance, minimum version, announcement, feature
    //   flags, sign-up mode). It holds no secrets, so anyone may read it, signed out included
    //   (the sign-in screen and a maintenance screen need it before there is a user).
    // config/limits: rate limits the Cloud Functions read (shared/limits.ts has the ranges).
    // config/ai: project AI settings (shared Gemini key on/off, Gemini or the free Gemma models,
    //   allow-list of emails, model, limits). Only the admin screen reads it; everyone else asks the aiStatus callable, so the
    //   allow-list never reaches other accounts.
    // Every write is by an admin, validated per document; nothing else under config/ exists.
    match /config/{id} {
      function validAnnouncement(a) {
        return a is map
          && a.keys().hasOnly(['text', 'level', 'until'])
          && a.text is string && a.text.size() > 0 && a.text.size() <= 300
          && a.level in ['info', 'warn']
          && (!('until' in a) || a.until is int);
      }
      // Feature flags: a known name → bool. Adding a flag means adding it here and in src/lib/flags.ts.
      function validFlags(f) {
        return f is map
          && f.keys().hasOnly(['aiImages', 'aiSms', 'liveTables', 'autoCapture', 'quickAdd', 'nudges', 'statementImport',
              'payLinks', 'duplicates', 'merchantMemory', 'whoseTurn', 'budgetAlerts', 'aiQuickAdd', 'aiPayments', 'openItems', 'groupChat', 'chatAi', 'pushPrompt', 'moneyReceived', 'vaults', 'aiIcons', 'aiIconAuto', 'whatsNew', 'joinApproval', 'aiTranscribe', 'aiTranscribeShared', 'profileSync'])
          && f.get('joinApproval', true) is bool
          && f.get('aiTranscribe', true) is bool && f.get('aiTranscribeShared', true) is bool && f.get('profileSync', true) is bool
          && f.get('openItems', true) is bool && f.get('groupChat', true) is bool && f.get('chatAi', true) is bool && f.get('aiIcons', true) is bool && f.get('aiIconAuto', true) is bool && f.get('whatsNew', true) is bool
          && f.get('pushPrompt', true) is bool && f.get('moneyReceived', true) is bool && f.get('vaults', true) is bool
          && f.get('aiQuickAdd', true) is bool && f.get('aiPayments', true) is bool
          && f.get('aiImages', true) is bool && f.get('aiSms', true) is bool && f.get('liveTables', true) is bool
          && f.get('autoCapture', true) is bool && f.get('quickAdd', true) is bool && f.get('nudges', true) is bool
          && f.get('statementImport', true) is bool && f.get('payLinks', true) is bool && f.get('duplicates', true) is bool
          && f.get('merchantMemory', true) is bool && f.get('whoseTurn', true) is bool && f.get('budgetAlerts', true) is bool;
      }
      // Numbers the app needs that an admin can tune; ranges mirror shared/app-tuning.ts.
      function validTuning(t) {
        return t is map
          && t.keys().hasOnly(['inboxPageSize', 'activityWindow', 'trashDays', 'vaultLockMinutes'])
          && t.get('inboxPageSize', 20) is int && t.get('inboxPageSize', 20) >= 10 && t.get('inboxPageSize', 20) <= 100
          && t.get('activityWindow', 15) is int && t.get('activityWindow', 15) >= 5 && t.get('activityWindow', 15) <= 50
          && t.get('trashDays', 30) is int && t.get('trashDays', 30) >= 7 && t.get('trashDays', 30) <= 90
          && t.get('vaultLockMinutes', 5) is int && t.get('vaultLockMinutes', 5) >= 1 && t.get('vaultLockMinutes', 5) <= 60;
      }
      function validAppConfig(d) {
        return d.keys().hasOnly(['maintenance', 'maintenanceMessage', 'minVersion', 'announcement', 'flags', 'signups', 'look', 'icons', 'tuning', 'updatedAt', 'updatedBy'])
          && validTuning(d.get('tuning', {}))
          && d.get('maintenance', false) is bool
          && (!('maintenanceMessage' in d) || (d.maintenanceMessage is string && d.maintenanceMessage.size() <= 300))
          && d.get('minVersion', '0.0.0') is string && d.get('minVersion', '0.0.0').matches('[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}')
          && (!('announcement' in d) || d.announcement == null || validAnnouncement(d.announcement))
          && validFlags(d.get('flags', {}))
          && d.get('signups', 'open') in ['open', 'invite']
          // How much the app explains (src/lib/look.ts LOOKS)
          && d.get('look', 'full') in ['full', 'needed', 'minimal', 'tooltip']
          // The default icon style (src/lib/icon-style.ts ICON_STYLES)
          && d.get('icons', 'outline') in ['outline', 'filled']
          && d.get('updatedAt', 0) is int
          && d.get('updatedBy', '') is string;
      }
      // Ranges mirror LIMIT_META in shared/limits.ts.
      function validLimits(d) {
        return d.keys().hasOnly(['capturePerHour', 'capturePerDay', 'aiOwnPerHour', 'aiOwnPerDay', 'nudgePerDay',
            'fxPerUserPerHour', 'fxPerUserPerDay', 'proofChecksPerHour', 'proofChecksPerDay', 'captureKeepDays', 'appErrorKeepDays', 'transcribeMaxKb', 'transcribePerDay', 'updatedAt', 'updatedBy'])
          && d.get('capturePerHour', 60) is int && d.get('capturePerHour', 60) >= 1 && d.get('capturePerHour', 60) <= 1000
          && d.get('capturePerDay', 300) is int && d.get('capturePerDay', 300) >= 1 && d.get('capturePerDay', 300) <= 10000
          && d.get('aiOwnPerHour', 120) is int && d.get('aiOwnPerHour', 120) >= 1 && d.get('aiOwnPerHour', 120) <= 1000
          && d.get('aiOwnPerDay', 600) is int && d.get('aiOwnPerDay', 600) >= 1 && d.get('aiOwnPerDay', 600) <= 10000
          && d.get('nudgePerDay', 1) is int && d.get('nudgePerDay', 1) >= 1 && d.get('nudgePerDay', 1) <= 20
          && d.get('fxPerUserPerHour', 30) is int && d.get('fxPerUserPerHour', 30) >= 1 && d.get('fxPerUserPerHour', 30) <= 500
          && d.get('fxPerUserPerDay', 200) is int && d.get('fxPerUserPerDay', 200) >= 1 && d.get('fxPerUserPerDay', 200) <= 5000
          && d.get('proofChecksPerHour', 10) is int && d.get('proofChecksPerHour', 10) >= 1 && d.get('proofChecksPerHour', 10) <= 100
          && d.get('proofChecksPerDay', 30) is int && d.get('proofChecksPerDay', 30) >= 1 && d.get('proofChecksPerDay', 30) <= 500
          && d.get('captureKeepDays', 30) is int && d.get('captureKeepDays', 30) >= 7 && d.get('captureKeepDays', 30) <= 365
          && d.get('appErrorKeepDays', 14) is int && d.get('appErrorKeepDays', 14) >= 1 && d.get('appErrorKeepDays', 14) <= 90
          && d.get('transcribeMaxKb', 512) is int && d.get('transcribeMaxKb', 512) >= 32 && d.get('transcribeMaxKb', 512) <= 4096
          && d.get('transcribePerDay', 40) is int && d.get('transcribePerDay', 40) >= 1 && d.get('transcribePerDay', 40) <= 1000
          && d.get('updatedAt', 0) is int
          && d.get('updatedBy', '') is string;
      }
      function validAiConfig(d) {
        return d.keys().hasOnly(['mode', 'engine', 'gemmaModel', 'allowEmails', 'images', 'sms', 'model', 'perDay', 'perHour', 'globalPerDay', 'pictures', 'picturesPerDay', 'pictureModel', 'transcribeModel', 'updatedAt', 'updatedBy'])
          && d.mode in ['off', 'everyone', 'allowlist']
          && d.get('engine', 'gemini') in ['gemini', 'gemma']
          && d.get('gemmaModel', '') is string && d.get('gemmaModel', '').size() <= 80
          && d.get('allowEmails', []) is list && d.get('allowEmails', []).size() <= 200
          && d.get('images', true) is bool
          && d.get('sms', true) is bool
          && d.get('model', '') is string && d.get('model', '').size() <= 80
          && d.get('perDay', 100) is int && d.get('perDay', 100) >= 1 && d.get('perDay', 100) <= 5000
          && d.get('perHour', 30) is int && d.get('perHour', 30) >= 1 && d.get('perHour', 30) <= 1000
          && d.get('globalPerDay', 2000) is int && d.get('globalPerDay', 2000) >= 1 && d.get('globalPerDay', 2000) <= 100000
          // "Draw a picture" on the shared key (paid per picture): off unless set
          && d.get('pictures', false) is bool
          && d.get('picturesPerDay', 5) is int && d.get('picturesPerDay', 5) >= 1 && d.get('picturesPerDay', 5) <= 100
          && d.get('pictureModel', '') is string && d.get('pictureModel', '').size() <= 80
          // the model Split Now's transcription key hears voice with (shared/transcribe.ts TRANSCRIBE_MODELS); '' = recommended
          && d.get('transcribeModel', '') in ['', 'gemini-3.5-flash-lite', 'gemini-3.1-flash-lite'];
      }
      allow get: if id == 'app' || isAdmin();
      allow list: if false;
      allow write: if isAdmin() && (
           (id == 'ai' && validAiConfig(request.resource.data))
        || (id == 'app' && validAppConfig(request.resource.data))
        || (id == 'limits' && validLimits(request.resource.data)));
    }
    // admins/{uid}: lets a user see that they're an admin. Written only by the Firebase console or the adminSetAdmin callable.
    match /admins/{id} {
      allow get: if isUser() && uid() == id;
      allow list, write: if false;
    }
    // blocked/{uid} = { reason, at, by }: written only by the adminBlockUser callable. Every
    // write by that account is refused (writesOpen); the account may read its own entry so the
    // app can say so, and admins may read any.
    match /blocked/{id} {
      allow get: if isUser() && (uid() == id || isAdmin());
      allow list, write: if false;
    }
    // stats/{kind}_{day}: daily usage counters (ai, capture, push, nudge) written by Cloud
    // Functions; admins read them (the console asks the adminStats callable for a range).
    match /stats/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // fxRates/{yyyy-mm-dd | latest}: shared ECB exchange rates (EUR-based), written only by the
    // fxDaily/fxMorning schedules and the refreshFx callable. Any signed-in user, guests at a
    // live table included (anonymous auth), may read them; nobody may write from a client.

    match /fxRates/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Auto-capture --------------------------------------------------
    // A capture token is a long random secret that lets a signed-out automation (an iOS Shortcut
    // calling the REST API) drop a transaction into captureInbox for its owner.
    match /captureTokens/{token} {
      allow get, list, delete: if isUser() && resource.data.uid == uid();
      allow create: if isUser()
        && writesOpen()
        && token.size() >= 24
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'groupId', 'label'])
        && (!('groupId' in request.resource.data) || (request.resource.data.groupId is string && request.resource.data.groupId.size() <= 64
            // a token can only be scoped to a group its owner is in
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && uid() in groupDoc(request.resource.data.groupId).data.memberUids))
        && (!('label' in request.resource.data) || (request.resource.data.label is string && request.resource.data.label.size() <= 60));
      allow update: if false;
    }

    // Written without Firebase Auth. The token must exist and belong to the uid on the doc;
    // only whitelisted, typed fields are allowed. Only the owner (signed in) can read or delete,
    // which the app does on open when it moves entries into users/{uid}/captures.
    match /captureInbox/{id} {
      function tokenOwner(t) { return get(/databases/$(database)/documents/captureTokens/$(t)).data.uid; }
      function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
      // createdAt (epoch ms) lets a Firestore TTL policy expire entries nobody ever claimed.
      function validInbox(d) {
        return d.keys().hasAll(['token', 'uid', 'merchant'])
          && d.keys().hasOnly(['token', 'uid', 'amount', 'raw', 'currency', 'merchant', 'ts', 'src', 'card', 'createdAt'])
          && (!('createdAt' in d) || d.createdAt is int)
          && d.token is string && d.token.size() >= 24 && d.token.size() <= 64
          && d.uid is string
          && d.merchant is string && d.merchant.size() > 0 && d.merchant.size() <= 100
          && (('amount' in d && d.amount is int && d.amount > 0)
              || (!('amount' in d) && d.raw is string && d.raw.size() > 0))
          && optStr(d, 'raw', 40) && optStr(d, 'currency', 3) && optStr(d, 'ts', 40)
          && optStr(d, 'src', 20) && optStr(d, 'card', 40);
      }
      allow create: if validInbox(request.resource.data)
        && exists(/databases/$(database)/documents/captureTokens/$(request.resource.data.token))
        && tokenOwner(request.resource.data.token) == request.resource.data.uid;
      allow get, list, delete: if isUser() && resource.data.uid == uid();
      allow update: if false;
    }

    // ---- Groups --------------------------------------------------------
    match /groups/{groupId} {
      function isMember() { return isUser() && uid() in resource.data.memberUids; }

      // Every field a group document may hold, with types and sizes. Membership fields are
      // further checked by isJoining / validMembershipChange. Any member may change the approval
      // settings and the currency (owner decision, Oct 2026); validGroupShape checks their values.
      // A picture icon (Draw a picture): a small image data: URL the phone made (shared/icon-ai.ts cleanIconImage).
      function validIconImage(v) {
        return v is string && v.size() <= 24000 && v.matches('data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+={0,2}');
      }
      function validGroupShape(g) {
        return g.keys().hasOnly(['id', 'name', 'emoji', 'type', 'currency', 'budget', 'startDate', 'endDate', 'simplify',
            'requireApproval', 'approvalThreshold', 'editAutoApprove', 'paymentApproval', 'captureOff', 'archived', 'archivedBy', 'deletedAt', 'deletedBy', 'memberUids', 'members', 'inviteCode',
            'createdBy', 'createdAt', 'updatedAt', 'joinCode', 'joinMemberId', 'memberOpId', 'mergeNeedsOk', 'vault', 'iconSvg', 'iconImage', 'approveJoins'])
          // A private group's name and emoji are tokens (docs/VAULT.md), longer than the text they hold.
          && g.name is string && g.name.size() > 0 && g.name.size() <= (g.get('vault', false) == true ? 200 : 80)
          && g.emoji is string && g.emoji.size() <= (g.get('vault', false) == true ? 80 : 16)
          // an AI-drawn icon (shared/svg-icon.ts SVG_MAX); a private group has none (it can't be sealed)
          && (!('iconSvg' in g) || (g.iconSvg is string && g.iconSvg.size() <= 4096 && g.get('vault', false) != true))
          && (!('iconImage' in g) || (validIconImage(g.iconImage) && g.get('vault', false) != true))
          && g.type in ['trip', 'outing', 'home', 'couple', 'event', 'office', 'family', 'sports', 'other', 'direct', 'personal']
          && g.currency is string && g.currency.size() == 3
          && g.members is map && g.members.size() <= 60
          && g.memberUids is list && g.memberUids.size() <= 60
          && (!('budget' in g) || (g.budget is int && g.budget >= 0))
          && (!('startDate' in g) || (g.startDate is string && g.startDate.size() == 10))
          && (!('endDate' in g) || (g.endDate is string && g.endDate.size() == 10))
          && (!('simplify' in g) || g.simplify is bool)
          && (!('requireApproval' in g) || g.requireApproval is bool)
          && (!('approvalThreshold' in g) || (g.approvalThreshold is int && g.approvalThreshold > 0))
          && (!('editAutoApprove' in g) || (g.editAutoApprove is int && g.editAutoApprove > 0))
          && g.get('paymentApproval', false) is bool
          && g.get('mergeNeedsOk', false) is bool
          && g.get('vault', false) is bool
          // New people need the creator's OK: nobody joins from the invite (isJoining), they ask (functions/src/join.ts)
          && g.get('approveJoins', false) is bool
          // captureOff is legacy (capture is paused per person now, users/{uid}/settings/notifications.pausedTrips)
          // and ignored; still allowed so old docs stay valid. `archived` is the legacy group-wide
          // archive (validArchiveChange stops anyone setting it again); archiving is personal now,
          // the uids in `archivedBy`.
          && g.get('captureOff', false) is bool
          && g.get('archived', false) is bool
          && g.get('archivedBy', []) is list && g.get('archivedBy', []).size() <= 60
          && (!('deletedAt' in g) || g.deletedAt is int)
          && (!('deletedBy' in g) || (g.deletedBy is string && g.deletedBy.size() <= 128))
          && (!('joinCode' in g) || g.joinCode is string)
          && (!('joinMemberId' in g) || g.joinMemberId is string)
          && (!('memberOpId' in g) || g.memberOpId is string);
      }
      // A non-member may join only by:
      //  - presenting the group's current invite code (joinCode == inviteCode),
      //  - adding exactly their own uid to memberUids,
      //  - writing exactly one members entry (joinMemberId) that carries their uid,
      //    and that entry must be new or an unclaimed placeholder.
      function isJoining() {
        let before = resource.data;
        let after = request.resource.data;
        let mid = after.joinMemberId;
        return isUser()
          && !(uid() in before.memberUids)
          // nobody joins a group in Recently deleted
          && !('deletedAt' in before)
          // nor a private group: they ask, and its creator lets them in (vault op requestJoin; docs/VAULT.md)
          && before.get('vault', false) != true
          // nor a group whose creator turned on "New people need my OK": the same, through the
          // joinApproval callable (functions/src/join.ts); old invite links included
          && before.get('approveJoins', false) != true
          && after.joinCode == before.inviteCode
          && after.memberUids.toSet() == before.memberUids.toSet().union([uid()].toSet())
          && after.memberUids.size() <= 60
          && after.diff(before).affectedKeys().hasOnly(['memberUids', 'members', 'joinCode', 'joinMemberId', 'updatedAt'])
          && after.members.diff(before.members).affectedKeys().hasOnly([mid])
          && after.members[mid].uid == uid()
          && after.members[mid].name is string && after.members[mid].name.size() <= 60
          && !('removedAt' in after.members[mid])
          // a new entry, an unclaimed placeholder, or their own entry from before they left
          && (!(mid in before.members) || !('uid' in before.members[mid])
              || (before.members[mid].uid == uid() && 'removedAt' in before.members[mid]));
      }

      // How an existing member may change membership. Every change to `members` must name
      // the single entry it touches in `memberOpId` (rules can't iterate a map), so:
      //  - existing entries are never edited in place (their uid is immutable, and a
      //    placeholder can only be claimed through isJoining),
      //  - a new entry is a placeholder (no uid),
      //  - removing an entry that has a uid also removes that uid from memberUids, and
      //    only the creator may do that to someone else (anyone may remove themselves),
      //  - removing is a soft remove: the entry stays, gaining only `removedAt` (epoch ms), so old
      //    expenses keep naming them (and the expense rules, which check paidBy/splits against
      //    members' keys, keep accepting edits). Hard deletes are still accepted from older apps,
      //  - adding a removed person back restores their entry as a placeholder (removedAt and any
      //    uid dropped, nothing else changed); someone with an account then rejoins with the invite,
      //  - memberUids never gains a uid here and only shrinks as above.
      // Membership checks, with the members diff worked out once and handed down as arguments.
      // Rules allow 1000 evaluation steps per request, and diffing the members map walks every
      // entry: recomputed for each test (as plain lets were), a group of a few people with emails
      // and photos ran out of steps and every member write was refused as "permission denied".
      // An update that leaves the members map and memberUids as they were skips the diff.
      function membershipOk() {
        let before = resource.data;
        let after = request.resource.data;
        return (after.members == before.members && after.memberUids == before.memberUids)
          || membershipOkWith(before, after, after.get('memberOpId', ''), after.members.diff(before.members),
            before.memberUids.toSet(), after.memberUids.toSet());
      }
      function membershipOkWith(before, after, op, mdiff, uidsBefore, uidsAfter) {
        return uidsAfter.difference(uidsBefore).size() == 0
          && membershipChangeOk(before, after, op, mdiff, uidsBefore.difference(uidsAfter));
      }
      function membershipChangeOk(before, after, op, mdiff, uidsRemoved) {
        return isOwnMemberEdit(before, after, op, mdiff, uidsRemoved)
          || validMembershipChange(before, op, mdiff, uidsRemoved, after.members.get(op, {}));
      }

      function validMembershipChange(before, op, mdiff, uidsRemoved, m) {
        let added = mdiff.addedKeys();
        let removed = mdiff.removedKeys();
        let changed = mdiff.changedKeys();
        let changedOnly = added.size() == 0 && removed.size() == 0 && changed.size() == 1 && changed.hasOnly([op]);
        let opener = (before.get('vault', false) != true && before.get('approveJoins', false) != true) || before.createdBy == uid();
        return (
            // no membership change at all
            (changed.size() == 0 && added.size() == 0 && removed.size() == 0 && uidsRemoved.size() == 0)
            // mark one member as removed: the entry gains only removedAt; a placeholder by anyone,
            // someone with an account by themselves or the creator (their uid leaves memberUids)
            || (changedOnly
                && !('removedAt' in before.members[op])
                && m.diff(before.members[op]).affectedKeys().hasOnly(['removedAt'])
                && m.removedAt is int
                && (('uid' in before.members[op]
                      && uidsRemoved == [before.members[op].uid].toSet()
                      && (before.members[op].uid == uid() || before.createdBy == uid()))
                    || (!('uid' in before.members[op]) && uidsRemoved.size() == 0)))
            // add a removed person back, as a placeholder (in a private group, or one whose new people need its creator's OK, only its creator adds people)
            || (opener && changedOnly
                && 'removedAt' in before.members[op]
                && !('removedAt' in m) && !('uid' in m)
                && m.diff(before.members[op]).affectedKeys().hasOnly(['removedAt', 'uid'])
                && uidsRemoved.size() == 0)
            // add one placeholder (in a private group, or one whose new people need its creator's OK, only its creator)
            || (opener && changed.size() == 0 && removed.size() == 0 && added.size() == 1 && added.hasOnly([op])
                && !('uid' in m) && uidsRemoved.size() == 0)
            // remove one placeholder (older apps; this app soft-removes)
            || (changed.size() == 0 && added.size() == 0 && removed.size() == 1 && removed.hasOnly([op])
                && !('uid' in before.members[op]) && uidsRemoved.size() == 0)
            // remove one joined member (yourself, or anyone if you created the group; older apps)
            || (changed.size() == 0 && added.size() == 0 && removed.size() == 1 && removed.hasOnly([op])
                && 'uid' in before.members[op]
                && uidsRemoved == [before.members[op].uid].toSet()
                && (before.members[op].uid == uid() || before.createdBy == uid()))
          );
      }

      // A member with an account may edit their own entry's name, photo and badge marks (copied from
      // their profile by their app, src/lib/pro.ts: `pro` is cosmetic and unchecked; `dev: true` only
      // from an admin, so nobody can pass as one), named in memberOpId. Nothing else about membership changes.
      function isOwnMemberEdit(before, after, op, mdiff, uidsRemoved) {
        let m = after.members[op];
        return mdiff.addedKeys().size() == 0 && mdiff.removedKeys().size() == 0
          && mdiff.changedKeys().size() == 1 && mdiff.changedKeys().hasOnly([op])
          && uidsRemoved.size() == 0
          && 'uid' in before.members[op] && before.members[op].uid == uid()
          && m.diff(before.members[op]).affectedKeys().hasOnly(['name', 'photoURL', 'pro', 'dev'])
          && (!('pro' in m) || m.pro is bool)
          // dev: a bool, and only an admin turns it on (one already there, e.g. from before someone
          // stopped being an admin, doesn't block their next name change; their app removes it)
          && (!('dev' in m) || (m.dev is bool && (m.dev == false || m.dev == before.members[op].get('dev', false) || isAdmin())))
          && m.name is string && m.name.size() > 0 && m.name.size() <= (after.get('vault', false) == true ? 200 : 100)
          && (!('photoURL' in m)
            || (m.photoURL is string && m.photoURL.size() <= 2048
              // a private group's photo link is a token (docs/VAULT.md)
              && (m.photoURL.matches('https://.+') || (after.get('vault', false) == true && m.photoURL.matches('v1:[A-Za-z0-9_-]+')))));
      }

      allow get: if isMember();
      allow list: if isUser() && uid() in resource.data.memberUids;
      // The creator starts as the only signed-up member (others join themselves via invite).
      // Invite codes are 8 characters (src/lib/id.ts), so a weak code can't expose a group.
      allow create: if isUser()
        && writesOpen()
        && request.resource.data.createdBy == uid()
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 8
        && validGroupShape(request.resource.data);
      allow update: if writesOpen() && ((isMember()
          // members can't silently change who created the group or its invite code
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          // private is chosen when the group is made and never changes (docs/VAULT.md)
          && request.resource.data.get('vault', false) == resource.data.get('vault', false)
          // only the creator decides whether merging two people needs their OK
          && (request.resource.data.get('mergeNeedsOk', false) == resource.data.get('mergeNeedsOk', false) || resource.data.createdBy == uid())
          // and whether new people need their OK to join
          && (request.resource.data.get('approveJoins', false) == resource.data.get('approveJoins', false) || resource.data.createdBy == uid())
          && validGroupShape(request.resource.data)
          && validArchiveChange()
          && validDeleteChange()
          && membershipOk())
        || isJoining());

      // Deleting is safe (shared/group-trash.ts): it sets deletedAt + deletedBy and nothing else,
      // by the creator, or by any member once the creator has left the group (the app also asks
      // that everyone be square then). deletedAt is the time of the write (within a few minutes,
      // for a phone's clock): an old or made-up stamp would hide the group from Recently deleted
      // and let the nightly purge take it at once. While deleted the group is read-only, and so is
      // everything in it (groupLive), except that any member may restore it by removing just those
      // two fields, or leave it (their own uid out, their entry marked removed) without bringing it
      // back for everyone. The daily purge removes it for good after tuning.trashDays (30 by
      // default); the creator may do so sooner, after the first 7 days (allow delete below).
      function validDeleteChange() {
        let wasDeleted = 'deletedAt' in resource.data;
        let isDeleted = 'deletedAt' in request.resource.data;
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        // (deletedBy compared directly, not through the whole-document diff: on a big group that diff
        // alone costs a large share of the rules' 1000 steps, see membershipOk)
        return (!wasDeleted && !isDeleted && request.resource.data.get('deletedBy', null) == resource.data.get('deletedBy', null))
          || (!wasDeleted && isDeleted
            && keys.hasOnly(['deletedAt', 'deletedBy'])
            && request.resource.data.deletedBy == uid()
            && request.resource.data.deletedAt is int
            && request.resource.data.deletedAt > request.time.toMillis() - 300000
            && request.resource.data.deletedAt < request.time.toMillis() + 300000
            && (resource.data.createdBy == uid() || !(resource.data.createdBy in resource.data.memberUids)))
          || (wasDeleted && !isDeleted && !('deletedBy' in request.resource.data)
            && keys.hasOnly(['deletedAt', 'deletedBy']))
          || (wasDeleted && isDeleted
            && keys.hasOnly(['members', 'memberUids', 'memberOpId', 'archivedBy', 'updatedAt'])
            && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()) == [uid()].toSet());
      }

      // Archiving is personal (shared/archive.ts): a member adds or removes only their own uid in
      // archivedBy, and nobody sets the old group-wide `archived` flag again. Unarchiving a group
      // archived that way may drop the flag and list everyone else (members only) instead.
      function validArchiveChange() {
        let before = resource.data.get('archivedBy', []).toSet();
        let after = request.resource.data.get('archivedBy', []).toSet();
        let legacyBefore = resource.data.get('archived', false) == true;
        let legacyAfter = request.resource.data.get('archived', false) == true;
        // whoever leaves the group in this write (themselves, or removed by the creator) may leave it too
        let leaving = resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet());
        // Nobody's archive changed (most writes): done, without the set arithmetic over every member.
        return (legacyAfter == legacyBefore && after == before)
          || (legacyAfter == legacyBefore
            && after.difference(before).hasOnly([uid()])
            && before.difference(after).difference(leaving.union([uid()].toSet())).size() == 0)
          || (legacyBefore && !legacyAfter
            && !(uid() in after)
            // everyone else stays archived: only you see the group again
            && resource.data.memberUids.toSet().difference([uid()].toSet()).difference(after).size() == 0
            && after.difference(before).hasOnly(resource.data.memberUids)
            && before.difference(after).hasOnly([uid()]));
      }
      // For good: only the creator, only from Recently deleted, and not in its first 7 days
      // (shared/group-trash.ts PURGE_HOLD_DAYS), so the others always get a week to restore it.
      allow delete: if isMember() && resource.data.createdBy == uid() && writesOpen()
        && resource.data.get('deletedAt', null) is int && !purgeHeld(resource.data.deletedAt);

      // createdBy is the writer on create and never changes afterwards.
      function validAuthor() {
        return (request.method == 'create' && request.resource.data.createdBy == uid())
          || (request.method == 'update' && request.resource.data.createdBy == resource.data.createdBy);
      }

      // ---- Trust fields (expenses + settlements) --------------------------
      // Soft delete: only deletedAt/deletedBy change; trashing records the caller as deletedBy,
      // restoring removes both. Any member may do either.
      function isTrashChange() {
        let before = resource.data;
        let after = request.resource.data;
        // deletedAt is about now (a day's slack for a phone that was offline), so a back-dated
        // stamp can't skip the purge hold below.
        return after.diff(before).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
          && (('deletedAt' in after && after.deletedAt is int && after.deletedBy == uid()
                && after.deletedAt > request.time.toMillis() - 86400000
                && after.deletedAt < request.time.toMillis() + 300000)
              || (!('deletedAt' in after) && !('deletedBy' in after)));
      }
      // Hard delete: from Recently deleted, by whoever trashed it or the group creator, once its
      // first 7 days are over; or anything in the group while its creator deletes the whole group
      // for good (purgeGroup), once the group's own 7 days are over. A live expense or payment in a
      // live group is never deleted outright: it goes to Recently deleted first.
      function canPurge() {
        let g = groupDoc(groupId).data;
        return (resource.data.get('deletedAt', null) is int && !purgeHeld(resource.data.deletedAt)
            && (resource.data.get('deletedBy', '') == uid() || g.createdBy == uid()))
          || (g.get('deletedAt', null) is int && g.createdBy == uid() && !purgeHeld(g.deletedAt));
      }
      function noTrustFieldsOnCreate() {
        return !request.resource.data.keys().hasAny(['deletedAt', 'deletedBy', 'dispute', 'approvals']);
      }

      match /expenses/{expenseId} {
        // A recurring occurrence keeps its template's author, whoever's client generates it:
        // its id must be <templateId>_<date> and the template must exist with the same createdBy.
        function isOccurrence() {
          let d = request.resource.data;
          let tpl = /databases/$(database)/documents/groups/$(groupId)/expenses/$(d.recurringFrom);
          return request.method == 'create'
            && d.get('recurringFrom', null) is string
            && d.date is string
            && expenseId == d.recurringFrom + '_' + d.date
            && exists(tpl)
            && get(tpl).data.createdBy == d.createdBy;
        }

        // Optional foreign-currency original (amount in its own minor units, locked FX rate).
        // amount/paidBy/splits stay in the group currency, so nothing else depends on it.
        function validOriginal(d) {
          return !('original' in d) || (
            d.original is map
            && d.original.keys().hasAll(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.original.keys().hasOnly(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.original.currency is string && d.original.currency.size() == 3
            && d.original.amount is int && d.original.amount > 0
            && d.original.rate is number && d.original.rate > 0
            && d.original.rateDate is string && d.original.rateDate.size() == 10
            && d.original.source in ['ecb', 'manual']);
        }

        // A receipt is an https URL and a Storage path inside this group's folder, so a doc can
        // never point the cleanup code at someone else's file.
        function validReceipt(d) {
          return (!('receiptUrl' in d) || (d.receiptUrl is string && d.receiptUrl.size() <= 1024 && d.receiptUrl.matches('https://.*')))
            && (!('receiptPath' in d) || (d.receiptPath is string && d.receiptPath.size() <= 256
                && d.receiptPath.matches('receipts/' + groupId + '/[A-Za-z0-9_.-]+')));
        }
        // Attached photos (receipt-photo.ts MAX_ATTACHED): up to 4, each a path inside this group's
        // folder (so cleanup can never be pointed elsewhere), an optional https URL and when it was added.
        function validPhoto(p) {
          return p is map && p.keys().hasOnly(['url', 'path', 'at']) && p.keys().hasAll(['path', 'at'])
            && p.path is string && p.path.size() <= 256 && p.path.matches('receipts/' + groupId + '/[A-Za-z0-9_.-]+')
            && p.at is int
            && (!('url' in p) || (p.url is string && p.url.size() <= 1024 && p.url.matches('https://.*')));
        }
        function validPhotos(d) {
          return !('photos' in d) || (d.photos is list && d.photos.size() <= 4
            && (d.photos.size() < 1 || validPhoto(d.photos[0]))
            && (d.photos.size() < 2 || validPhoto(d.photos[1]))
            && (d.photos.size() < 3 || validPhoto(d.photos[2]))
            && (d.photos.size() < 4 || validPhoto(d.photos[3])));
        }
        function validExpense() {
          let d = request.resource.data;
          return (validAuthor() || isOccurrence())
            && validOriginal(d)
            && validReceipt(d)
            && validPhotos(d)
            && d.groupId == groupId
            && d.amount is int
            && d.amount > 0
            && d.description is string && d.description.size() <= 200
            && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
            // a chosen icon: one emoji, or its token in a private group (shared/vault-convert.ts CAPS.emoji)
            && (!('icon' in d) || (d.icon is string && d.icon.size() <= 80))
            // the icon was the automatic one's AI pick (Automatic stays chosen when it's edited)
            && d.get('iconAuto', true) == true
            // an AI-drawn icon (shared/svg-icon.ts SVG_MAX), never in a private group: it can't be sealed
            && (!('iconSvg' in d) || (d.iconSvg is string && d.iconSvg.size() <= 4096 && groupDoc(groupId).data.get('vault', false) != true))
            // a picture (Draw a picture, shrunk on the phone): a small image data: URL (shared/icon-ai.ts ICON_IMAGE_MAX), never in a private group
            && (!('iconImage' in d) || (validIconImage(d.iconImage) && groupDoc(groupId).data.get('vault', false) != true))
            && d.paidBy is map && d.paidBy.size() <= 60
            && d.splits is map && d.splits.size() <= 60
            // everyone who paid or owes must be a member of this group
            && d.paidBy.keys().hasOnly(groupDoc(groupId).data.members.keys())
            && d.splits.keys().hasOnly(groupDoc(groupId).data.members.keys())
            && validKind(d);
        }
        // Money received (shared/received.ts) is the only other kind, stored with the roles
        // swapped; an entry stays what it was added as (an edit can't turn spending into income).
        function validKind(d) {
          return (!('kind' in d) || d.kind == 'received')
            && (request.method == 'create' || d.get('kind', null) == resource.data.get('kind', null));
        }
        // With group.requireApproval, an expense above its threshold (approvalThresholdOf) must
        // carry requiresApproval when created or when its amount changes.
        function approvalFlagOk() {
          let d = request.resource.data;
          return !(approvalNeeded(groupDoc(groupId).data, d.amount)
                   && (request.method == 'create' || d.amount != resource.data.amount))
            || d.get('requiresApproval', false) == true;
        }
        // A normal edit can't touch anyone's flag or the trash fields, and may only remove
        // approvals (the app clears them when the money changes); approving is its own write
        // (isFlagOrApproval). It may drop requiresApproval only when the new amount no longer
        // needs approval (at or below the threshold, or the group turned approval off): the
        // expense then counts at once.
        function trustFieldsKept() {
          let before = resource.data;
          let after = request.resource.data;
          let approvals = after.get('approvals', {}).diff(before.get('approvals', {}));
          return !after.diff(before).affectedKeys().hasAny(['dispute', 'deletedAt', 'deletedBy'])
            && approvals.changedKeys().size() == 0
            && approvals.addedKeys().size() == 0
            && (before.get('requiresApproval', false) != true || after.get('requiresApproval', false) == true
                || !approvalNeeded(groupDoc(groupId).data, after.amount));
        }
        // An amount change that still needs approval asks everyone again: approvals are reset to
        // at most the editor's own. Except when the group has edit auto-approve and the expense
        // was already marked: a change of at most editAutoApprove (either direction) keeps the
        // approvals and the mark as they are.
        function withinEditAutoApprove(g, before, after) {
          return 'editAutoApprove' in g
            && before.get('requiresApproval', false) == true
            && after.amount - before.amount <= g.editAutoApprove
            && before.amount - after.amount <= g.editAutoApprove;
        }
        function approvalsResetOk() {
          let g = groupDoc(groupId).data;
          let before = resource.data;
          let after = request.resource.data;
          return after.amount == before.amount
            || !approvalNeeded(g, after.amount)
            || withinEditAutoApprove(g, before, after)
            || after.get('approvals', {}).keys().hasOnly([uid()]);
        }
        // Flag / resolve / approve: only the caller's own key in `dispute` and `approvals`,
        // and nothing else in the document.
        function ownKeyOnly(field) {
          return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
        }
        function validFlag(f) {
          return f.keys().hasOnly(['byUid', 'memberId', 'reason', 'at'])
            && f.byUid == uid()
            && f.reason is string && f.reason.size() > 0 && f.reason.size() <= 500
            && f.at is int
            && f.memberId is string
            // the flagger flags as themselves and is part of the expense
            && groupDoc(groupId).data.members[f.memberId].get('uid', '') == uid()
            && (f.memberId in resource.data.splits || f.memberId in resource.data.paidBy);
        }
        function isFlagOrApproval() {
          let after = request.resource.data;
          let flags = after.get('dispute', {});
          let approvals = after.get('approvals', {});
          return after.diff(resource.data).affectedKeys().hasOnly(['dispute', 'approvals'])
            && ownKeyOnly('dispute') && ownKeyOnly('approvals')
            && (!(uid() in flags) || validFlag(flags[uid()]))
            && (!(uid() in approvals) || approvals[uid()] == true);
        }

        allow read: if isGroupMember(groupId);
        // Who last edited it: an edit (any change outside the flag, approval, trash and schedule
        // writes) must name the person making it, so "edited by" and the functions' pushes can trust it. A new
        // expense has none (createdBy says who added it). Server rewrites (member merges) set it
        // to whoever carried them out.
        function editorRecorded() {
          return request.resource.data.get('updatedBy', '') == uid()
            // Except a repeating expense's schedule moving on: any member's app advances
            // recurrence.nextDate when it adds the next copies. Nobody edited anything, and no
            // money changes, so it leaves the editor as it was.
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recurrence']);
        }

        allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId) && validExpense() && noTrustFieldsOnCreate() && approvalFlagOk()
          && !('updatedBy' in request.resource.data);
        allow update: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
          && ((validExpense() && trustFieldsKept() && approvalFlagOk() && approvalsResetOk() && editorRecorded()) || isTrashChange() || isFlagOrApproval());
        allow delete: if isGroupMember(groupId) && writesOpen() && canPurge();

        // Comment thread on an expense. Comments are immutable; only the author can
        // delete one, except that the group creator (who may purge any expense, comments
        // included, and delete the whole group) may delete any, and members may clean up
        // comments of an expense that is being deleted in the same batch (or is already gone).
        // The creator check reads only the group doc: deleting a big group's comments must
        // not need one existsAfter() per expense (rules allow 20 document reads per batch).
        match /comments/{commentId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
            && request.resource.data.authorUid == uid()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.authorName is string
            && request.resource.data.createdAt is int;
          allow update: if false;
          allow delete: if isUser() && writesOpen() && (resource.data.authorUid == uid()
            || (isGroupMember(groupId)
              && (groupDoc(groupId).data.createdBy == uid()
                || !existsAfter(/databases/$(database)/documents/groups/$(groupId)/expenses/$(expenseId)))));
        }
      }

      match /settlements/{settlementId} {
        // Paid in another currency (src/lib/collect.ts): what changed hands, beside `amount` (what it
        // cleared, in the group currency). Never the group's own currency.
        function validPaid(d) {
          return !('paid' in d) || (
            d.paid is map
            && d.paid.keys().hasAll(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.paid.keys().hasOnly(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.paid.currency is string && d.paid.currency.size() == 3
            && d.paid.currency != groupDoc(groupId).data.currency
            && d.paid.amount is int && d.paid.amount > 0 && d.paid.amount <= 100000000000
            && d.paid.rate is number && d.paid.rate > 0
            && d.paid.rateDate is string && d.paid.rateDate.size() == 10
            && d.paid.source in ['ecb', 'manual']);
        }
        // Payments need the recipient's OK (shared/payment-ok.ts). The payee's account, when they
        // have one and are still in the group; '' otherwise.
        function payeeUidOf(d) {
          let m = groupDoc(groupId).data.members[d.to];
          return m.get('uid', '') is string && !('removedAt' in m) ? m.get('uid', '') : '';
        }
        // A new payment carries needsOk exactly when the group asks for the payee's OK and someone
        // else records it. An import by the group's creator is exempt (it copies payments made long
        // ago into their group); anyone else's import waits like any payment, so the field can't be
        // used to skip the OK. It can't arrive already OK'd, flagged or checked, and its screenshot
        // sits at its own path.
        function okFieldsOnCreate(d) {
          let payee = payeeUidOf(d);
          let imported = 'importedFrom' in d && groupDoc(groupId).data.createdBy == uid();
          let asks = groupDoc(groupId).data.get('paymentApproval', false) == true && payee != '' && payee != uid() && !imported;
          return (asks ? d.get('needsOk', false) == true : !('needsOk' in d))
            && !d.keys().hasAny(['ok', 'flag', 'aiCheck'])
            && (!('proofPath' in d) || d.proofPath == 'settleproofs/' + groupId + '/' + settlementId + '.jpg');
        }
        // The payee's OK ({by, at, via: 'payee'}, clearing a flag) or flag ({by, at, reason?},
        // dropping an OK), and nothing else. The server writes OKs from the screenshot check.
        function isPayeeDecision() {
          let d = request.resource.data;
          return resource.data.get('needsOk', false) == true
            && payeeUidOf(resource.data) == uid()
            && d.diff(resource.data).affectedKeys().hasOnly(['ok', 'flag'])
            && (('ok' in d && !('flag' in d)
                  && d.ok.keys().hasAll(['by', 'at', 'via']) && d.ok.keys().hasOnly(['by', 'at', 'via'])
                  && d.ok.by == uid() && d.ok.at is int && d.ok.via == 'payee')
              || ('flag' in d && !('ok' in d)
                  && d.flag.keys().hasAll(['by', 'at']) && d.flag.keys().hasOnly(['by', 'at', 'reason'])
                  && d.flag.by == uid() && d.flag.at is int
                  && (!('reason' in d.flag) || (d.flag.reason is string && d.flag.reason.size() <= 500))));
        }
        function validSettlement() {
          return validAuthor()
            // Every field a payment may hold (src/types.ts Settlement); nothing else rides along.
            && request.resource.data.keys().hasOnly(['id', 'groupId', 'from', 'to', 'amount', 'method', 'note', 'date', 'createdBy',
                'createdAt', 'importedFrom', 'payLink', 'paid', 'needsOk', 'ok', 'flag', 'proofPath', 'aiCheck', 'deletedAt', 'deletedBy'])
            && validPaid(request.resource.data)
            && (!('importedFrom' in request.resource.data) || request.resource.data.importedFrom in ['splitwise', 'csv'])
            && (!('payLink' in request.resource.data) || (request.resource.data.payLink is string && request.resource.data.payLink.size() <= 40))
            && request.resource.data.groupId == groupId
            && request.resource.data.amount is int
            && request.resource.data.amount > 0
            && (!('method' in request.resource.data) || (request.resource.data.method is string && request.resource.data.method.size() <= 40))
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
            && request.resource.data.from != request.resource.data.to
            && request.resource.data.from in groupDoc(groupId).data.members
            && request.resource.data.to in groupDoc(groupId).data.members;
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId) && validSettlement() && noTrustFieldsOnCreate()
          && okFieldsOnCreate(request.resource.data);
        // A recorded payment is never edited (the app records a new one instead): only moved to
        // trash and back, or OK'd / flagged by its payee. So an OK can't be followed by a new
        // amount or a different payer or payee.
        allow update: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
          && (isTrashChange() || isPayeeDecision());
        allow delete: if isGroupMember(groupId) && writesOpen() && canPurge();
      }

      // Append-only activity log (edit history, feed). Entries are written by members in the
      // same batch as the change they describe, as themselves, and never edited. The creator
      // may delete them only together with the group itself (group gone after the batch).
      match /activity/{activityId} {
        function validEntry(d) {
          return d.keys().hasAll(['type', 'actorUid', 'actorName', 'targetId', 'summary', 'createdAt'])
            && d.keys().hasOnly(['type', 'actorUid', 'actorName', 'targetId', 'summary', 'before', 'after', 'createdAt'])
            && d.actorUid == uid()
            // The kinds the app writes (src/types.ts ActivityType). `settlement.nudged` is the nudge
            // callable's alone (Admin SDK), so a client can't fake a push it never sent.
            && d.type in ['expense.created', 'expense.updated', 'expense.deleted', 'expense.restored', 'expense.purged',
                'expense.disputed', 'expense.resolved', 'expense.approved', 'expense.imported',
                'settlement.created', 'settlement.deleted', 'settlement.restored', 'settlement.purged',
                'settlement.approved', 'settlement.flagged',
                'member.added', 'member.removed', 'group.updated']
            // a private group's names and lines are tokens, longer than the text they hold (docs/VAULT.md)
            && d.actorName is string && d.actorName.size() <= 200
            && d.targetId is string && d.targetId.size() <= 200
            && d.summary is string && d.summary.size() <= 1000
            && d.createdAt is int
            && (!('before' in d) || d.before is map)
            && (!('after' in d) || d.after is map);
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId) && validEntry(request.resource.data);
        allow update: if false;
        allow delete: if isUser() && writesOpen()
          && groupDoc(groupId).data.createdBy == uid()
          && !existsAfter(/databases/$(database)/documents/groups/$(groupId));
      }

      // Open items (src/lib/open-items.ts): something spent that nobody has added yet. Any member
      // writes one down, edits it while it's open, deletes it (soft, so Undo works) and claims it.
      // A claim is written in the same batch as the new expense it points at (by the claimer), and
      // only on an item that is open, or whose claiming expense was deleted since (so the item
      // counts as open again). Two people claiming at once: the second batch fails.
      match /openItems/{itemId} {
        function validItem(d) {
          return d.keys().hasAll(['groupId', 'title', 'status', 'createdBy', 'createdAt', 'updatedAt'])
            && d.keys().hasOnly(['groupId', 'title', 'category', 'icon', 'iconAuto', 'iconSvg', 'iconImage', 'date', 'amount', 'notes', 'suspects', 'status', 'expenseId',
                'claimedBy', 'claimedAt', 'deletedAt', 'deletedBy', 'createdBy', 'createdAt', 'updatedAt'])
            && d.groupId == groupId
            && d.title is string && d.title.size() > 0 && d.title.size() <= 120
            && (!('category' in d) || (d.category is string && d.category.size() <= 32))
            // its icon, as an expense's: one emoji (or its token in a private group), the AI pick's mark,
            // an AI-drawn icon and a picture, those two never in a private group (they can't be sealed)
            && (!('icon' in d) || (d.icon is string && d.icon.size() <= 80))
            && d.get('iconAuto', true) == true
            && (!('iconSvg' in d) || (d.iconSvg is string && d.iconSvg.size() <= 4096 && groupDoc(groupId).data.get('vault', false) != true))
            && (!('iconImage' in d) || (validIconImage(d.iconImage) && groupDoc(groupId).data.get('vault', false) != true))
            && (!('date' in d) || (d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')))
            && (!('amount' in d) || (d.amount is int && d.amount > 0 && d.amount <= 100000000000))
            && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500))
            // the people someone thinks paid: members of this group
            && (!('suspects' in d) || (d.suspects is list && d.suspects.size() <= 20
                && d.suspects.hasOnly(groupDoc(groupId).data.members.keys())))
            && d.status in ['open', 'claimed']
            && d.createdAt is int && d.updatedAt is int;
        }
        function expensePath(id) { return /databases/$(database)/documents/groups/$(groupId)/expenses/$(id); }
        // Open now: never claimed, or the expense that claimed it is in Recently deleted or gone.
        function claimable(d) {
          return d.status == 'open' || !('expenseId' in d) || !exists(expensePath(d.expenseId))
            || 'deletedAt' in get(expensePath(d.expenseId)).data;
        }
        function isEdit() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'category', 'icon', 'iconAuto', 'iconSvg', 'iconImage', 'date', 'amount', 'notes', 'suspects', 'updatedAt'])
            && !('deletedAt' in resource.data)
            && claimable(resource.data);
        }
        function isItemTrashChange() {
          let after = request.resource.data;
          return after.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'updatedAt'])
            && (('deletedAt' in after && after.deletedAt is int && after.deletedBy == uid())
                || (!('deletedAt' in after) && !('deletedBy' in after)));
        }
        function isClaim() {
          let after = request.resource.data;
          return after.diff(resource.data).affectedKeys().hasOnly(['status', 'expenseId', 'claimedBy', 'claimedAt', 'updatedAt'])
            && !('deletedAt' in resource.data)
            && claimable(resource.data)
            && after.status == 'claimed'
            && after.claimedBy == uid()
            && after.claimedAt is int
            && after.expenseId is string
            // the expense is written in this same batch, by the claimer, and wasn't there before
            && !exists(expensePath(after.expenseId))
            && existsAfter(expensePath(after.expenseId))
            && getAfter(expensePath(after.expenseId)).data.createdBy == uid();
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
          && validItem(request.resource.data)
          && request.resource.data.createdBy == uid()
          && request.resource.data.status == 'open'
          && !request.resource.data.keys().hasAny(['expenseId', 'claimedBy', 'claimedAt', 'deletedAt', 'deletedBy']);
        allow update: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
          && validItem(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && (isEdit() || isItemTrashChange() || isClaim());
        // Removed for good only with the group ("Delete forever" by its creator).
        allow delete: if isUser() && writesOpen() && isGroupMember(groupId) && groupDoc(groupId).data.createdBy == uid();
      }

      // Two entries that are one person (functions/src/merge-members.ts): members read the open
      // ones (the Members screen, the chat card); only the functions write them.
      match /mergeRequests/{requestId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Group chat (src/lib/chat.ts): every member reads the whole history, including people who
      // joined later. Messages are words or a card (open item, Pay me, Settle up, balances,
      // expense), sent as the writer. A message may tag people (mentions: member ids, or 'all'),
      // ask only some people (to), and quote the message it answers (replyTo, a copy). The author
      // may edit their words (and tags) later, which stamps editedAt; nothing else changes. The
      // author deletes their own; the group's creator may delete any (only "Delete forever" does).
      // No photos: text only.
      // groups/{gid}/joinRequests/{uid}: someone asking to join a private group (functions/src/vault.ts
      // requestJoin / decideJoin) or an ordinary one with approveJoins on (functions/src/join.ts).
      // Written by the server alone; read by the asker (their own request, nothing else of the
      // group) and the group's creator.
      match /joinRequests/{requesterId} {
        allow read: if isUser() && (requesterId == uid() || groupDoc(groupId).data.createdBy == uid());
        allow write: if false;
      }

      match /chat/{messageId} {
        function idList(x) {
          return x is list && x.size() <= 60;
        }
        function validReply(r) {
          return r is map && r.keys().hasOnly(['id', 'authorUid', 'authorName', 'text']) && r.keys().hasAll(['id', 'authorUid', 'authorName', 'text'])
            && r.id is string && r.id.size() > 0 && r.id.size() <= 64
            && r.authorUid is string && r.authorUid.size() <= 128
            && r.authorName is string && r.authorName.size() <= 200
            && r.text is string && r.text.size() <= 160;
        }
        function validMessage(d) {
          return d.keys().hasAll(['authorUid', 'authorName', 'text', 'kind', 'createdAt'])
            && d.keys().hasOnly(['authorUid', 'authorName', 'text', 'kind', 'ref', 'amount', 'mentions', 'to', 'replyTo', 'editedAt', 'createdAt'])
            && d.authorUid == uid()
            && d.authorName is string && d.authorName.size() <= 200
            && d.text is string && d.text.size() <= 1000
            && d.kind in ['text', 'openItem', 'pay', 'expense', 'settle', 'balances']
            && (d.kind != 'text' || d.text.size() > 0)
            && (!('ref' in d) || (d.ref is string && d.ref.size() > 0 && d.ref.size() <= 64))
            && ((d.kind in ['openItem', 'expense']) == ('ref' in d))
            && (!('amount' in d) || (d.amount is int && d.amount > 0 && d.amount <= 100000000000))
            && ((d.kind == 'pay') == ('amount' in d))
            // tags: at most 20 (shared/mentions.ts MAX_MENTIONS); `to` may name up to 60
            && (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 20))
            && (!('to' in d) || (idList(d.to) && d.to.size() > 0 && d.kind in ['pay', 'settle']))
            && (!('replyTo' in d) || validReply(d.replyTo))
            && (!('editedAt' in d) || d.editedAt is int)
            && d.createdAt is int;
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && groupLive(groupId) && validMessage(request.resource.data);
        allow update: if isGroupMember(groupId) && writesOpen() && groupLive(groupId)
          && resource.data.authorUid == uid()
          && validMessage(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt'])
          && request.resource.data.editedAt is int;
        allow delete: if isUser() && writesOpen() && isGroupMember(groupId)
          && (resource.data.authorUid == uid() || groupDoc(groupId).data.createdBy == uid());
      }

      // Name + payment handles (+ profile photo URL, currency, Collect in, and `pro` / `dev` while their
      // badge shows, src/lib/pro.ts: pro cosmetic, dev only from an admin) a member shares with this group only.
      // Written by the owner (also in the same batch as creating/joining the group, hence getAfter).
      // A private group's copy of someone (docs/VAULT.md): their name, photo link and payment details
      // only as tokens sealed on their phone, never in the clear (an older app's plain copy is refused).
      function sealedProfileCopy(d) {
        return (d.displayName == '' || (d.displayName.size() <= 200 && d.displayName.matches('v1:[A-Za-z0-9_-]+')))
          && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.size() <= 2048 && d.photoURL.matches('v1:[A-Za-z0-9_-]+')))
          && (!('payment' in d) || (d.payment is string && d.payment.size() <= 1000 && d.payment.matches('v1:[A-Za-z0-9_-]+')));
      }
      match /profiles/{userId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isUser() && uid() == userId && writesOpen() && groupLive(groupId)
          && uid() in groupAfter(groupId).data.memberUids
          && request.resource.data.keys().hasOnly(['displayName', 'payment', 'photoURL', 'currency', 'collect', 'pro', 'dev'])
          && request.resource.data.displayName is string
          && (!('pro' in request.resource.data) || request.resource.data.pro is bool)
          // the Dev badge: only an admin may say so
          && (!('dev' in request.resource.data) || request.resource.data.dev == false || (request.resource.data.dev == true && isAdmin()))
          && (!('currency' in request.resource.data) || (request.resource.data.currency is string && request.resource.data.currency.size() == 3))
          && (!('collect' in request.resource.data) || request.resource.data.collect is bool)
          && (groupAfter(groupId).data.get('vault', false) == true
            ? sealedProfileCopy(request.resource.data)
            : (!('payment' in request.resource.data) || request.resource.data.payment is map)
              && (!('photoURL' in request.resource.data)
                || (request.resource.data.photoURL is string
                  && request.resource.data.photoURL.size() <= 2048
                  && request.resource.data.photoURL.matches('https://.+'))));
        // the owner, or the group creator when removing the member / deleting the group
        allow delete: if isUser() && writesOpen() && (uid() == userId
          || (isGroupMember(groupId) && groupDoc(groupId).data.createdBy == uid()));
      }
    }

    // ---- Live table split ---------------------------------------------
    // tables/{code}: a bill everyone at the table claims items on, from their own phone.
    // The doc id is the share code (8 random chars), so knowing the code is what grants access;
    // there is no list. Guests sign in anonymously and their participant id is their uid.
    // Claims live at claims.{uid}.{itemId} = shares, so a guest's write can be confined to
    // their own key without iterating the items.
    match /tables/{code} {
      function isHost() { return signedIn() && resource.data.hostUid == uid(); }
      function isLive(t) { return t.status == 'open' && request.time.toMillis() < t.expiresAt; }
      // How tax/fees and discounts are shared (absent means by items); the tip is always equal.
      function validTaxSplit(t) { return !('taxSplit' in t) || t.taxSplit in ['items', 'equal']; }
      function validParticipant(p, pid) {
        return p is map
          && p.keys().hasOnly(['name', 'uid', 'joinedAt'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 40
          && p.joinedAt is int
          && (!('uid' in p) || p.uid == pid);
      }
      // A guest may add/rename only their own participant entry and replace only their own claims.
      function isGuestUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let me = uid();
        let claimsAfter = after.get('claims', {});
        return signedIn()
          && isLive(before)
          && after.diff(before).affectedKeys().hasOnly(['participants', 'claims'])
          && after.participants.diff(before.participants).affectedKeys().hasOnly([me])
          && claimsAfter.diff(before.get('claims', {})).affectedKeys().hasOnly([me])
          // you must be at the table (after this write) and your entry carries your uid
          && me in after.participants
          && validParticipant(after.participants[me], me)
          && after.participants[me].uid == me
          && (!(me in claimsAfter)
            || (claimsAfter[me] is map
              && claimsAfter[me].size() <= 100
              && claimsAfter[me].keys().hasOnly(before.items.keys())));
      }

      // Anyone signed in (anonymous included) with the code can read an open, unexpired table;
      // the host and the people who joined can still read it after it closes (the summary).
      // A missing doc is readable so the host's client can check a fresh code is free.
      allow get: if signedIn() && (resource == null
        || resource.data.hostUid == uid()
        || isLive(resource.data)
        || uid() in resource.data.participants);
      allow list: if signedIn() && resource.data.hostUid == uid();
      allow create: if signedIn()
        && writesOpen()
        && request.resource.data.hostUid == uid()
        && request.resource.data.code == code
        && code.size() >= 6 && code.size() <= 12
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['code', 'groupId', 'hostUid', 'merchant', 'currency', 'date', 'items', 'extras',
          'participants', 'claims', 'hostPayment', 'status', 'createdAt', 'expiresAt', 'expenseId', 'closedGroupId', 'taxSplit'])
        && validTaxSplit(request.resource.data)
        && request.resource.data.items is map && request.resource.data.items.size() <= 200
        && request.resource.data.claims is map
        && request.resource.data.createdAt is int && request.resource.data.expiresAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 600000
        && request.resource.data.expiresAt - request.resource.data.createdAt <= 86400000
        && request.resource.data.participants[uid()].uid == uid();
      // The host can change anything except who hosts it, its code and when it expires.
      allow update: if writesOpen() && ((isHost()
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.code == resource.data.code
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['open', 'closed']
          && validTaxSplit(request.resource.data))
        || isGuestUpdate());
      allow delete: if isHost() && writesOpen();
    }

    // ---- Pay me links --------------------------------------------------
    // payLinks/{code}: a payee asks to be paid with a link that works without an account. The
    // code (20–40 random lowercase letters and digits) is the secret: anyone signed in, anonymous
    // included, may get a link they have the code for; only the payee lists their own. Only the payee
    // creates (for a debt in a group they are in, or a live table they host) or cancels one.
    // Anyone with the code may make exactly one change, while it is open and unexpired: open →
    // paid with paidAt, paidBy (themselves) and optionally method and a proof under
    // payproofs/{code}/ (open → claimed instead for a table link not locked to one guest, which
    // only the host may then confirm → paid or dismiss → open). The onPayLinkPaid function
    // records the settlement (Admin SDK) on → paid.
    // It shows the payee's chosen handles (UPI ID, UPI number, PayID, PayPal, Revolut; never bank
    // account numbers) to anyone with the code: the owner accepted that (docs/PLAN.md §4.3).
    match /payLinks/{code} {
      function linkStr(d, k, max) { return d[k] is string && d[k].size() > 0 && d[k].size() <= max; }
      function linkOptStr(d, k, max) { return !(k in d) || linkStr(d, k, max); }
      function validHandles(h) {
        return h is map
          && h.keys().hasOnly(['upi', 'phone', 'payid', 'paypal', 'revolut'])
          && linkOptStr(h, 'upi', 100) && linkOptStr(h, 'phone', 100) && linkOptStr(h, 'payid', 100)
          && linkOptStr(h, 'paypal', 100) && linkOptStr(h, 'revolut', 100);
      }
      // The payee is the creator's own member entry in a group they belong to, owed by another member.
      function payeeInGroup(d) {
        let g = groupDoc(d.groupId).data;
        return uid() in g.memberUids
          && !('deletedAt' in g)
          && d.to in g.members && g.members[d.to].get('uid', '') == uid()
          && d.from in g.members
          && d.currency == g.currency;
      }
      // A live table closed without a group: the host is the payee, the debtor one of its people.
      function hostOfTable(d) {
        let t = get(/databases/$(database)/documents/tables/$(d.tableCode)).data;
        return t.hostUid == uid() && d.to == uid() && d.from in t.participants;
      }
      function validNewLink(d) {
        let now = request.time.toMillis();
        return d.keys().hasAll(['groupName', 'from', 'to', 'amount', 'currency', 'payeeName', 'payerName', 'payment',
            'createdBy', 'createdAt', 'expiresAt', 'status'])
          && d.keys().hasOnly(['groupId', 'groupName', 'emoji', 'tableCode', 'from', 'to', 'amount', 'currency', 'payeeName', 'payerName',
            'payment', 'forUid', 'createdBy', 'createdAt', 'expiresAt', 'status', 'parts'])
          && d.createdBy == uid()
          && d.status == 'open'
          && d.amount is int && d.amount > 0 && d.amount <= 100000000000
          && d.currency is string && d.currency.size() == 3
          && linkStr(d, 'from', 64) && linkStr(d, 'to', 128) && d.from != d.to
          && linkStr(d, 'groupName', 80) && linkStr(d, 'payeeName', 80) && linkStr(d, 'payerName', 80)
          && linkOptStr(d, 'emoji', 16) && linkOptStr(d, 'forUid', 128) && linkOptStr(d, 'tableCode', 12)
          && validHandles(d.payment)
          && d.createdAt is int && d.createdAt > now - 600000 && d.createdAt < now + 600000
          && d.expiresAt is int && d.expiresAt > d.createdAt && d.expiresAt - d.createdAt <= 2678400000
          && (('groupId' in d && !('parts' in d) && linkStr(d, 'groupId', 64) && payeeInGroup(d))
            || (!('groupId' in d) && !('parts' in d) && 'tableCode' in d && hostOfTable(d))
            // In another currency or across groups (shared/paylinks.ts PayLinkPart): up to 8 groups.
            // Rules can't loop over them; the trigger checks each part (both people members, the
            // payee is the maker, the group's currency) before recording anything, as the payee.
            || (!('groupId' in d) && !('tableCode' in d) && 'parts' in d && d.parts is list && d.parts.size() > 0 && d.parts.size() <= 8));
      }
      function paidBySettlement(l, sid) {
        let st = getAfter(/databases/$(database)/documents/groups/$(l.groupId)/settlements/$(sid)).data;
        return st.get('payLink', '') == code && st.from == l.from && st.to == l.to && !('deletedAt' in st);
      }
      // A live table link not locked to one guest: "I've paid" waits for the host (open → claimed).
      function needsHostConfirm(l) { return 'tableCode' in l && !('forUid' in l); }
      // "I've paid": the only change someone other than the payee may make, once. Straight to paid
      // on a Remind link, a guest's own link, or with the member's own settlement; else claimed.
      function isPaidClaim() {
        let before = resource.data;
        let after = request.resource.data;
        let now = request.time.toMillis();
        return signedIn()
          && before.status == 'open'
          // on hold while its group is in Recently deleted (functions/src/trash.ts)
          && !before.get('held', false)
          && now < before.expiresAt
          && ((after.status == 'paid' && (!needsHostConfirm(before) || 'settlementId' in after))
            || (after.status == 'claimed' && needsHostConfirm(before) && !('settlementId' in after)))
          && after.diff(before).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'method', 'proofPath', 'settlementId'])
          && after.paidAt is int && after.paidAt > now - 600000 && after.paidAt < now + 600000
          && after.paidBy == uid()
          && (!('forUid' in before) || before.forUid == uid())
          && linkOptStr(after, 'method', 40)
          && (!('proofPath' in after) || (after.proofPath is string
            && after.proofPath.matches('payproofs/' + code + '/[A-Za-z0-9_-]{1,64}[.]jpg')))
          // A member who recorded the payment in Settle up says which settlement cleared it: it
          // must really exist (written first, or in the same batch), between the same two people,
          // and name this link, so a link can't be closed with no payment behind it.
          && (!('settlementId' in after) || (isUser() && 'groupId' in before
            && uid() in groupDoc(before.groupId).data.memberUids
            && linkStr(after, 'settlementId', 64)
            && paidBySettlement(before, after.settlementId)));
      }
      // The host on a claimed link: Confirm (→ paid, the claim kept; the trigger records it) or
      // Dismiss (→ open, the claim fields removed, so it can be paid and claimed again).
      function isHostDecision() {
        let before = resource.data;
        let after = request.resource.data;
        return isUser()
          && before.createdBy == uid()
          && before.status == 'claimed'
          && ((after.status == 'paid' && after.diff(before).affectedKeys().hasOnly(['status']))
            || (after.status == 'open'
              && after.diff(before).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'method', 'proofPath'])
              && !after.keys().hasAny(['paidAt', 'paidBy', 'method', 'proofPath'])));
      }
      function isCancel() {
        return isUser()
          && resource.data.createdBy == uid()
          && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt is int;
      }
      allow get: if signedIn();
      // The payee lists their own links (the Inbox's claims to confirm); the query must filter createdBy == their uid.
      allow list: if isUser() && resource.data.createdBy == uid();
      allow create: if isUser() && writesOpen()
        && code.size() >= 20 && code.size() <= 40 && code.matches('[a-z0-9]+')
        && validNewLink(request.resource.data);
      allow update: if writesOpen() && (isPaidClaim() || isHostDecision() || isCancel());
      allow delete: if isUser() && writesOpen() && resource.data.createdBy == uid();
    }

    // ---- Invites -------------------------------------------------------
    // Lookup table for signed-in users: code → group name + unclaimed placeholders.
    // An invite can only point at a group whose inviteCode is this doc's id, written by
    // a member of that group (after the batch, so create-group / join can include it).
    match /invites/{code} {
      function validInvite() {
        let g = groupAfter(request.resource.data.groupId);
        return isUser()
          && code.size() >= 8
          && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'emoji', 'placeholders', 'vault', 'approveJoins'])
          && request.resource.data.get('vault', false) is bool
          // a hint for the invite page (Ask to join); the group's own approveJoins is what isJoining checks
          && request.resource.data.get('approveJoins', false) is bool
          && request.resource.data.groupId is string
          && (!('groupName' in request.resource.data) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 80))
          && (!('placeholders' in request.resource.data) || (request.resource.data.placeholders is map && request.resource.data.placeholders.size() <= 60))
          && g != null
          && g.data.inviteCode == code
          && uid() in g.data.memberUids;
      }
      // Someone leaving a group (a member before the batch, not after) may tidy the invite in
      // the same batch, but only by removing placeholder entries: nothing is added or renamed.
      function isLeaverCleanup() {
        let before = resource.data;
        let after = request.resource.data;
        let ph = after.get('placeholders', {}).diff(before.get('placeholders', {}));
        return isUser()
          && after.groupId == before.groupId
          && after.diff(before).affectedKeys().hasOnly(['placeholders'])
          && ph.addedKeys().size() == 0
          && ph.changedKeys().size() == 0
          && uid() in groupDoc(before.groupId).data.memberUids
          && !(uid() in groupAfter(before.groupId).data.memberUids);
      }
      allow get: if isUser();
      allow list: if false;
      allow create: if validInvite() && writesOpen();
      allow update: if writesOpen() && ((validInvite() && request.resource.data.groupId == resource.data.groupId) || isLeaverCleanup());
      allow delete: if isUser() && writesOpen() && isGroupMember(resource.data.groupId)
        && groupDoc(resource.data.groupId).data.inviteCode == code;
    }
  }
}
