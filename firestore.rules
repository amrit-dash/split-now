rules_version = '2';

// Split Now — Firestore security rules.
// Model: a user can see a group only if their uid is in group.memberUids.
// Anonymous accounts (live-table guests) are not users: they can read a table they have the
// code for, and the shared exchange rates, and nothing else.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // A real account (Google / email): anonymous sign-in only exists for live tables.
    function isUser() { return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'; }
    function uid() { return request.auth.uid; }
    // admins/{uid}: created by hand in the Firebase console; no client can write it.
    function isAdmin() { return isUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function groupDoc(groupId) { return get(/databases/$(database)/documents/groups/$(groupId)); }
    // A group's "Needs your OK" threshold in minor units: its own, else its currency's default.
    // The same table as src/lib/approval.ts APPROVAL_DEFAULTS (a unit test keeps them equal);
    // other currencies get the flat fallback.
    function approvalThresholdOf(g) {
      return g.get('approvalThreshold', {'INR': 200000, 'USD': 10000, 'EUR': 10000, 'GBP': 10000, 'AUD': 10000, 'NZD': 10000, 'CAD': 10000,
        'SGD': 10000, 'CHF': 10000, 'AED': 30000, 'THB': 200000, 'MYR': 30000, 'LKR': 1000000, 'NPR': 300000, 'JPY': 10000, 'KRW': 100000,
        'IDR': 100000000, 'HKD': 50000, 'CNY': 50000, 'PHP': 500000, 'VND': 2000000, 'ZAR': 100000, 'SEK': 100000, 'NOK': 100000,
        'DKK': 50000}.get(g.currency, 10000));
    }
    // Whether an expense of `amount` in this group must be approved (strictly above the threshold).
    function approvalNeeded(g, amount) {
      return g.get('requireApproval', false) == true && amount > approvalThresholdOf(g);
    }
    function isGroupMember(groupId) { return isUser() && uid() in groupDoc(groupId).data.memberUids; }
    // State of the group once the current write (or batch) is applied.
    function groupAfter(groupId) { return getAfter(/databases/$(database)/documents/groups/$(groupId)); }

    // Maintenance mode (config/app.maintenance, set in the admin console) and blocked accounts
    // (blocked/{uid}, written by the adminBlockUser callable) stop every write except an
    // admin's. Two small reads per write, both cached per request; the admin check only runs
    // when one of them says no.
    function maintenanceOn() {
      let p = /databases/$(database)/documents/config/app;
      return exists(p) && get(p).data.get('maintenance', false) == true;
    }
    function isBlocked() { return exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function writesOpen() { return (!maintenanceOn() && !isBlocked()) || isAdmin(); }

    // ---- Users ---------------------------------------------------------
    // Private profile (email, default currency, payment handles). Owner only.
    // What co-members may see (name + payment handles) is copied by the owner into
    // groups/{groupId}/profiles/{uid}, readable only by that group's members.
    match /users/{userId} {
      // "Ask for approval on big expenses" (approvalDefault) and "Approve small edits
      // automatically" (editAutoApproveDefault), Settings → Preferences: the defaults for groups
      // this user creates, each { on, amount (minor units of currency), currency }.
      function validAmountSetting(p, field) {
        return !(field in p) || (
          p[field] is map
          && p[field].keys().hasAll(['on', 'amount', 'currency'])
          && p[field].keys().hasOnly(['on', 'amount', 'currency'])
          && p[field].on is bool
          && p[field].amount is int
          && p[field].amount > 0 && p[field].amount <= 100000000000
          && p[field].currency is string && p[field].currency.size() == 3);
      }
      function validApprovalDefault(p) {
        return validAmountSetting(p, 'approvalDefault') && validAmountSetting(p, 'editAutoApproveDefault');
      }

      allow get: if isUser() && uid() == userId;
      allow list: if false;
      allow create, update: if isUser() && uid() == userId
        && request.resource.data.uid == userId
        && writesOpen()
        && validApprovalDefault(request.resource.data);
      allow delete: if isUser() && uid() == userId;

      // Captured transactions waiting to be sorted into a group: private to the user.
      // The user's own Gemini key: written and read only by Cloud Functions (aiKey), never by the app.
      match /secrets/{id} {
        allow read, write: if false;
      }
      // Server-written AI status (key hint, last error); the owner can read it.
      match /aiState/{id} {
        allow read: if isUser() && uid() == userId;
        allow write: if false;
      }

      match /captures/{captureId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.status in ['pending', 'assigned', 'dismissed'];
      }

      // FCM Web Push registrations, one per browser (doc id = hash of the token). Owner only;
      // Cloud Functions read them (Admin SDK) to send and delete dead ones.
      match /pushTokens/{tokenId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && request.resource.data.keys().hasOnly(['token', 'ua', 'createdAt', 'lastSeen'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() <= 300))
          && request.resource.data.createdAt is int
          && request.resource.data.lastSeen is int;
      }

      // What the capture webhook did with each request (result, amount, merchant; never SMS
      // text). Written only by the Cloud Function (Admin SDK); the owner may read and clear it.
      match /captureLog/{entryId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if false;
      }

      // Per-user settings. settings/notifications holds push preferences and auto-capture
      // settings (outsideTrips, capturePaused, minAmount, ignoreWords) and AI reading (aiSms, aiImages).
      match /settings/{settingId} {
        allow read, delete: if isUser() && uid() == userId;
        allow create, update: if isUser() && uid() == userId
          && writesOpen()
          && (settingId != 'notifications' || (
            request.resource.data.keys().hasOnly(['captures', 'unsorted', 'expenses', 'settlements', 'reminders', 'outsideTrips',
              'capturePaused', 'minAmount', 'ignoreWords', 'aiSms', 'aiSmsMerchant', 'aiImages', 'aiEnabled', 'aiSource', 'aiModel', 'updatedAt'])
            && request.resource.data.get('captures', true) is bool
            && request.resource.data.get('unsorted', false) is bool
            && request.resource.data.get('expenses', true) is bool
            && request.resource.data.get('settlements', true) is bool
            && request.resource.data.get('reminders', true) is bool
            && request.resource.data.get('outsideTrips', false) is bool
            // Auto-capture filters (shared/capture-filters.ts; the webhook re-normalises them)
            && request.resource.data.get('capturePaused', false) is bool
            && request.resource.data.get('minAmount', 0) is int
            && request.resource.data.get('minAmount', 0) >= 0 && request.resource.data.get('minAmount', 0) <= 10000000
            && request.resource.data.get('ignoreWords', []) is list
            && request.resource.data.get('ignoreWords', []).size() <= 20
            // AI reading (Gemini) of SMS and images; on unless turned off
            && request.resource.data.get('aiSms', true) is bool
            && request.resource.data.get('aiSmsMerchant', false) is bool
            && request.resource.data.get('aiImages', true) is bool
            && request.resource.data.get('aiEnabled', true) is bool
            && request.resource.data.get('aiSource', 'auto') in ['auto', 'own', 'app']
            && request.resource.data.get('aiModel', '') is string && request.resource.data.get('aiModel', '').size() <= 80
            && request.resource.data.get('updatedAt', 0) is int))
          // settings/merchants: merchant → category memory (src/lib/merchants.ts). Two maps keyed by
          // the normalised merchant, at most 200 entries each; the app evicts the least recently used.
          && (settingId != 'merchants' || (
            request.resource.data.keys().hasOnly(['categories', 'touched', 'updatedAt'])
            && request.resource.data.categories is map && request.resource.data.categories.size() <= 200
            && request.resource.data.get('touched', {}) is map && request.resource.data.get('touched', {}).size() <= 200
            && request.resource.data.get('updatedAt', 0) is int));
      }
    }

    // ---- Server-only state (Cloud Functions, Admin SDK) ----------------
    // rateLimits/{tokenHash}: capture webhook counters. reminderState/{groupId}: when each
    // member was last nudged to settle up. No client access at all.
    match /rateLimits/{id} {
      allow read, write: if false;
    }
    match /reminderState/{id} {
      allow read, write: if false;
    }

    // ---- Admin-managed configuration (config/*, admins/*, blocked/*, stats/*) ----------
    // config/app: the app's public switches (maintenance, minimum version, announcement, feature
    //   flags, sign-up mode). It holds no secrets, so anyone may read it, signed out included
    //   (the sign-in screen and a maintenance screen need it before there is a user).
    // config/limits: rate limits the Cloud Functions read (shared/limits.ts has the ranges).
    // config/ai: project AI settings (shared Gemini key on/off, allow-list of emails, model,
    //   limits). Only the admin screen reads it; everyone else asks the aiStatus callable, so the
    //   allow-list never reaches other accounts.
    // Every write is by an admin, validated per document; nothing else under config/ exists.
    match /config/{id} {
      function validAnnouncement(a) {
        return a is map
          && a.keys().hasOnly(['text', 'level', 'until'])
          && a.text is string && a.text.size() > 0 && a.text.size() <= 300
          && a.level in ['info', 'warn']
          && (!('until' in a) || a.until is int);
      }
      // Feature flags: a known name → bool. Adding a flag means adding it here and in src/lib/flags.ts.
      function validFlags(f) {
        return f is map
          && f.keys().hasOnly(['aiImages', 'aiSms', 'liveTables', 'autoCapture', 'quickAdd', 'nudges', 'statementImport',
              'payLinks', 'duplicates', 'merchantMemory', 'whoseTurn', 'budgetAlerts'])
          && f.get('aiImages', true) is bool && f.get('aiSms', true) is bool && f.get('liveTables', true) is bool
          && f.get('autoCapture', true) is bool && f.get('quickAdd', true) is bool && f.get('nudges', true) is bool
          && f.get('statementImport', true) is bool && f.get('payLinks', true) is bool && f.get('duplicates', true) is bool
          && f.get('merchantMemory', true) is bool && f.get('whoseTurn', true) is bool && f.get('budgetAlerts', true) is bool;
      }
      function validAppConfig(d) {
        return d.keys().hasOnly(['maintenance', 'maintenanceMessage', 'minVersion', 'announcement', 'flags', 'signups', 'version', 'updatedAt', 'updatedBy'])
          && d.get('maintenance', false) is bool
          && (!('maintenanceMessage' in d) || (d.maintenanceMessage is string && d.maintenanceMessage.size() <= 300))
          && d.get('minVersion', '0.0.0') is string && d.get('minVersion', '0.0.0').matches('[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}')
          && (!('announcement' in d) || d.announcement == null || validAnnouncement(d.announcement))
          && validFlags(d.get('flags', {}))
          && d.get('signups', 'open') in ['open', 'invite']
          // The version shown in Profile (src/lib/flags.ts DISPLAY_VERSION).
          && (!('version' in d) || (d.version is string && d.version.matches('^[0-9]+([.][0-9]+){0,3}([-+][0-9A-Za-z.]{1,20})?$')))
          && d.get('updatedAt', 0) is int
          && d.get('updatedBy', '') is string;
      }
      // Ranges mirror LIMIT_META in shared/limits.ts.
      function validLimits(d) {
        return d.keys().hasOnly(['capturePerHour', 'capturePerDay', 'aiOwnPerHour', 'aiOwnPerDay', 'nudgePerDay',
            'fxPerUserPerHour', 'fxPerUserPerDay', 'updatedAt', 'updatedBy'])
          && d.get('capturePerHour', 60) is int && d.get('capturePerHour', 60) >= 1 && d.get('capturePerHour', 60) <= 1000
          && d.get('capturePerDay', 300) is int && d.get('capturePerDay', 300) >= 1 && d.get('capturePerDay', 300) <= 10000
          && d.get('aiOwnPerHour', 120) is int && d.get('aiOwnPerHour', 120) >= 1 && d.get('aiOwnPerHour', 120) <= 1000
          && d.get('aiOwnPerDay', 600) is int && d.get('aiOwnPerDay', 600) >= 1 && d.get('aiOwnPerDay', 600) <= 10000
          && d.get('nudgePerDay', 1) is int && d.get('nudgePerDay', 1) >= 1 && d.get('nudgePerDay', 1) <= 20
          && d.get('fxPerUserPerHour', 30) is int && d.get('fxPerUserPerHour', 30) >= 1 && d.get('fxPerUserPerHour', 30) <= 500
          && d.get('fxPerUserPerDay', 200) is int && d.get('fxPerUserPerDay', 200) >= 1 && d.get('fxPerUserPerDay', 200) <= 5000
          && d.get('updatedAt', 0) is int
          && d.get('updatedBy', '') is string;
      }
      function validAiConfig(d) {
        return d.keys().hasOnly(['mode', 'allowEmails', 'images', 'sms', 'model', 'perDay', 'perHour', 'globalPerDay', 'updatedAt', 'updatedBy'])
          && d.mode in ['off', 'everyone', 'allowlist']
          && d.get('allowEmails', []) is list && d.get('allowEmails', []).size() <= 200
          && d.get('images', true) is bool
          && d.get('sms', true) is bool
          && d.get('model', '') is string && d.get('model', '').size() <= 80
          && d.get('perDay', 100) is int && d.get('perDay', 100) >= 1 && d.get('perDay', 100) <= 5000
          && d.get('perHour', 30) is int && d.get('perHour', 30) >= 1 && d.get('perHour', 30) <= 1000
          && d.get('globalPerDay', 2000) is int && d.get('globalPerDay', 2000) >= 1 && d.get('globalPerDay', 2000) <= 100000;
      }
      allow get: if id == 'app' || isAdmin();
      allow list: if false;
      allow write: if isAdmin() && (
           (id == 'ai' && validAiConfig(request.resource.data))
        || (id == 'app' && validAppConfig(request.resource.data))
        || (id == 'limits' && validLimits(request.resource.data)));
    }
    // admins/{uid}: lets a user see that they're an admin. Managed in the Firebase console only.
    match /admins/{id} {
      allow get: if isUser() && uid() == id;
      allow list, write: if false;
    }
    // blocked/{uid} = { reason, at, by }: written only by the adminBlockUser callable. Every
    // write by that account is refused (writesOpen); the account may read its own entry so the
    // app can say so, and admins may read any.
    match /blocked/{id} {
      allow get: if isUser() && (uid() == id || isAdmin());
      allow list, write: if false;
    }
    // stats/{kind}_{day}: daily usage counters (ai, capture, push, nudge) written by Cloud
    // Functions; admins read them (the console asks the adminStats callable for a range).
    match /stats/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // fxRates/{yyyy-mm-dd | latest}: shared ECB exchange rates (EUR-based), written only by the
    // fxDaily/fxMorning schedules and the refreshFx callable. Any signed-in user, guests at a
    // live table included (anonymous auth), may read them; nobody may write from a client.

    match /fxRates/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---- Auto-capture --------------------------------------------------
    // A capture token is a long random secret that lets a signed-out automation (an iOS Shortcut
    // calling the REST API) drop a transaction into captureInbox for its owner.
    match /captureTokens/{token} {
      allow get, list, delete: if isUser() && resource.data.uid == uid();
      allow create: if isUser()
        && writesOpen()
        && token.size() >= 24
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'groupId', 'label'])
        && (!('groupId' in request.resource.data) || (request.resource.data.groupId is string && request.resource.data.groupId.size() <= 64
            // a token can only be scoped to a group its owner is in
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && uid() in groupDoc(request.resource.data.groupId).data.memberUids))
        && (!('label' in request.resource.data) || (request.resource.data.label is string && request.resource.data.label.size() <= 60));
      allow update: if false;
    }

    // Written without Firebase Auth. The token must exist and belong to the uid on the doc;
    // only whitelisted, typed fields are allowed. Only the owner (signed in) can read or delete,
    // which the app does on open when it moves entries into users/{uid}/captures.
    match /captureInbox/{id} {
      function tokenOwner(t) { return get(/databases/$(database)/documents/captureTokens/$(t)).data.uid; }
      function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
      // createdAt (epoch ms) lets a Firestore TTL policy expire entries nobody ever claimed.
      function validInbox(d) {
        return d.keys().hasAll(['token', 'uid', 'merchant'])
          && d.keys().hasOnly(['token', 'uid', 'amount', 'raw', 'currency', 'merchant', 'ts', 'src', 'card', 'createdAt'])
          && (!('createdAt' in d) || d.createdAt is int)
          && d.token is string && d.token.size() >= 24 && d.token.size() <= 64
          && d.uid is string
          && d.merchant is string && d.merchant.size() > 0 && d.merchant.size() <= 100
          && (('amount' in d && d.amount is int && d.amount > 0)
              || (!('amount' in d) && d.raw is string && d.raw.size() > 0))
          && optStr(d, 'raw', 40) && optStr(d, 'currency', 3) && optStr(d, 'ts', 40)
          && optStr(d, 'src', 20) && optStr(d, 'card', 40);
      }
      allow create: if validInbox(request.resource.data)
        && exists(/databases/$(database)/documents/captureTokens/$(request.resource.data.token))
        && tokenOwner(request.resource.data.token) == request.resource.data.uid;
      allow get, list, delete: if isUser() && resource.data.uid == uid();
      allow update: if false;
    }

    // ---- Groups --------------------------------------------------------
    match /groups/{groupId} {
      function isMember() { return isUser() && uid() in resource.data.memberUids; }

      // Every field a group document may hold, with types and sizes. Membership fields are
      // further checked by isJoining / validMembershipChange; policy fields by creatorPolicy.
      function validGroupShape(g) {
        return g.keys().hasOnly(['id', 'name', 'emoji', 'type', 'currency', 'budget', 'startDate', 'endDate', 'simplify',
            'requireApproval', 'approvalThreshold', 'editAutoApprove', 'captureOff', 'archived', 'memberUids', 'members', 'inviteCode',
            'createdBy', 'createdAt', 'updatedAt', 'joinCode', 'joinMemberId', 'memberOpId'])
          && g.name is string && g.name.size() > 0 && g.name.size() <= 80
          && g.emoji is string && g.emoji.size() <= 16
          && g.type in ['trip', 'outing', 'home', 'couple', 'event', 'office', 'other', 'direct', 'personal']
          && g.currency is string && g.currency.size() == 3
          && g.members is map && g.members.size() <= 60
          && g.memberUids is list && g.memberUids.size() <= 60
          && (!('budget' in g) || (g.budget is int && g.budget >= 0))
          && (!('startDate' in g) || (g.startDate is string && g.startDate.size() == 10))
          && (!('endDate' in g) || (g.endDate is string && g.endDate.size() == 10))
          && (!('simplify' in g) || g.simplify is bool)
          && (!('requireApproval' in g) || g.requireApproval is bool)
          && (!('approvalThreshold' in g) || (g.approvalThreshold is int && g.approvalThreshold > 0))
          && (!('editAutoApprove' in g) || (g.editAutoApprove is int && g.editAutoApprove > 0))
          // "Pause auto-capture for this trip" and "Archive": any member may flip them
          && g.get('captureOff', false) is bool
          && g.get('archived', false) is bool
          && (!('joinCode' in g) || g.joinCode is string)
          && (!('joinMemberId' in g) || g.joinMemberId is string)
          && (!('memberOpId' in g) || g.memberOpId is string);
      }
      // Approval settings are a trust control: only the group's creator changes them.
      function creatorPolicy() {
        let b = resource.data;
        let a = request.resource.data;
        return b.createdBy == uid()
          || (a.get('requireApproval', false) == b.get('requireApproval', false)
              && a.get('approvalThreshold', 0) == b.get('approvalThreshold', 0)
              && a.get('editAutoApprove', 0) == b.get('editAutoApprove', 0));
      }

      // A non-member may join only by:
      //  - presenting the group's current invite code (joinCode == inviteCode),
      //  - adding exactly their own uid to memberUids,
      //  - writing exactly one members entry (joinMemberId) that carries their uid,
      //    and that entry must be new or an unclaimed placeholder.
      function isJoining() {
        let before = resource.data;
        let after = request.resource.data;
        let mid = after.joinMemberId;
        return isUser()
          && !(uid() in before.memberUids)
          && after.joinCode == before.inviteCode
          && after.memberUids.toSet() == before.memberUids.toSet().union([uid()].toSet())
          && after.memberUids.size() <= 60
          && after.diff(before).affectedKeys().hasOnly(['memberUids', 'members', 'joinCode', 'joinMemberId', 'updatedAt'])
          && after.members.diff(before.members).affectedKeys().hasOnly([mid])
          && after.members[mid].uid == uid()
          && after.members[mid].name is string && after.members[mid].name.size() <= 60
          && (!(mid in before.members) || !('uid' in before.members[mid]));
      }

      // How an existing member may change membership. Every change to `members` must name
      // the single entry it touches in `memberOpId` (rules can't iterate a map), so:
      //  - existing entries are never edited in place (their uid is immutable, and a
      //    placeholder can only be claimed through isJoining),
      //  - a new entry is a placeholder (no uid),
      //  - removing an entry that has a uid also removes that uid from memberUids, and
      //    only the creator may do that to someone else (anyone may remove themselves),
      //  - memberUids never gains a uid here and only shrinks as above.
      function validMembershipChange() {
        let before = resource.data;
        let after = request.resource.data;
        let mdiff = after.members.diff(before.members);
        let uidsAdded = after.memberUids.toSet().difference(before.memberUids.toSet());
        let uidsRemoved = before.memberUids.toSet().difference(after.memberUids.toSet());
        let op = after.get('memberOpId', '');
        return uidsAdded.size() == 0
          && mdiff.changedKeys().size() == 0
          && (
            // no membership change at all
            (mdiff.addedKeys().size() == 0 && mdiff.removedKeys().size() == 0 && uidsRemoved.size() == 0)
            // add one placeholder
            || (mdiff.removedKeys().size() == 0 && mdiff.addedKeys().size() == 1 && mdiff.addedKeys().hasOnly([op])
                && !('uid' in after.members[op]) && uidsRemoved.size() == 0)
            // remove one placeholder
            || (mdiff.addedKeys().size() == 0 && mdiff.removedKeys().size() == 1 && mdiff.removedKeys().hasOnly([op])
                && !('uid' in before.members[op]) && uidsRemoved.size() == 0)
            // remove one joined member (yourself, or anyone if you created the group)
            || (mdiff.addedKeys().size() == 0 && mdiff.removedKeys().size() == 1 && mdiff.removedKeys().hasOnly([op])
                && 'uid' in before.members[op]
                && uidsRemoved == [before.members[op].uid].toSet()
                && (before.members[op].uid == uid() || before.createdBy == uid()))
          );
      }

      // A member with an account may edit their own entry's name and photo (copied from their
      // profile by their app), named in memberOpId. Nothing else about membership changes.
      function isOwnMemberEdit() {
        let before = resource.data;
        let after = request.resource.data;
        let op = after.get('memberOpId', '');
        let mdiff = after.members.diff(before.members);
        let m = after.members[op];
        return mdiff.addedKeys().size() == 0 && mdiff.removedKeys().size() == 0
          && mdiff.changedKeys().size() == 1 && mdiff.changedKeys().hasOnly([op])
          && after.memberUids.toSet() == before.memberUids.toSet()
          && 'uid' in before.members[op] && before.members[op].uid == uid()
          && m.diff(before.members[op]).affectedKeys().hasOnly(['name', 'photoURL'])
          && m.name is string && m.name.size() > 0 && m.name.size() <= 100
          && (!('photoURL' in m)
            || (m.photoURL is string && m.photoURL.size() <= 2048 && m.photoURL.matches('https://.+')));
      }

      allow get: if isMember();
      allow list: if isUser() && uid() in resource.data.memberUids;
      // The creator starts as the only signed-up member (others join themselves via invite).
      // Invite codes are 8 characters (src/lib/id.ts), so a weak code can't expose a group.
      allow create: if isUser()
        && writesOpen()
        && request.resource.data.createdBy == uid()
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 8
        && validGroupShape(request.resource.data);
      allow update: if writesOpen() && ((isMember()
          // members can't silently change who created the group or its invite code
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && validGroupShape(request.resource.data)
          && creatorPolicy()
          && (validMembershipChange() || isOwnMemberEdit()))
        || isJoining());
      allow delete: if isMember() && resource.data.createdBy == uid() && writesOpen();

      // createdBy is the writer on create and never changes afterwards.
      function validAuthor() {
        return (request.method == 'create' && request.resource.data.createdBy == uid())
          || (request.method == 'update' && request.resource.data.createdBy == resource.data.createdBy);
      }

      // ---- Trust fields (expenses + settlements) --------------------------
      // Soft delete: only deletedAt/deletedBy change; trashing records the caller as deletedBy,
      // restoring removes both. Any member may do either.
      function isTrashChange() {
        let before = resource.data;
        let after = request.resource.data;
        return after.diff(before).affectedKeys().hasOnly(['deletedAt', 'deletedBy'])
          && (('deletedAt' in after && after.deletedAt is int && after.deletedBy == uid())
              || (!('deletedAt' in after) && !('deletedBy' in after)));
      }
      // Hard delete: whoever trashed it, or the group creator.
      function canPurge() {
        return resource.data.get('deletedBy', '') == uid() || groupDoc(groupId).data.createdBy == uid();
      }
      function noTrustFieldsOnCreate() {
        return !request.resource.data.keys().hasAny(['deletedAt', 'deletedBy', 'dispute', 'approvals']);
      }

      match /expenses/{expenseId} {
        // A recurring occurrence keeps its template's author, whoever's client generates it:
        // its id must be <templateId>_<date> and the template must exist with the same createdBy.
        function isOccurrence() {
          let d = request.resource.data;
          let tpl = /databases/$(database)/documents/groups/$(groupId)/expenses/$(d.recurringFrom);
          return request.method == 'create'
            && d.get('recurringFrom', null) is string
            && d.date is string
            && expenseId == d.recurringFrom + '_' + d.date
            && exists(tpl)
            && get(tpl).data.createdBy == d.createdBy;
        }

        // Optional foreign-currency original (amount in its own minor units, locked FX rate).
        // amount/paidBy/splits stay in the group currency, so nothing else depends on it.
        function validOriginal(d) {
          return !('original' in d) || (
            d.original is map
            && d.original.keys().hasAll(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.original.keys().hasOnly(['currency', 'amount', 'rate', 'rateDate', 'source'])
            && d.original.currency is string && d.original.currency.size() == 3
            && d.original.amount is int && d.original.amount > 0
            && d.original.rate is number && d.original.rate > 0
            && d.original.rateDate is string && d.original.rateDate.size() == 10
            && d.original.source in ['ecb', 'manual']);
        }

        // A receipt is an https URL and a Storage path inside this group's folder, so a doc can
        // never point the cleanup code at someone else's file.
        function validReceipt(d) {
          return (!('receiptUrl' in d) || (d.receiptUrl is string && d.receiptUrl.size() <= 1024 && d.receiptUrl.matches('https://.*')))
            && (!('receiptPath' in d) || (d.receiptPath is string && d.receiptPath.size() <= 256
                && d.receiptPath.matches('receipts/' + groupId + '/[A-Za-z0-9_.-]+')));
        }
        function validExpense() {
          let d = request.resource.data;
          return (validAuthor() || isOccurrence())
            && validOriginal(d)
            && validReceipt(d)
            && d.groupId == groupId
            && d.amount is int
            && d.amount > 0
            && d.description is string && d.description.size() <= 200
            && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
            && d.paidBy is map && d.paidBy.size() <= 60
            && d.splits is map && d.splits.size() <= 60
            // everyone who paid or owes must be a member of this group
            && d.paidBy.keys().hasOnly(groupDoc(groupId).data.members.keys())
            && d.splits.keys().hasOnly(groupDoc(groupId).data.members.keys());
        }
        // With group.requireApproval, an expense above its threshold (approvalThresholdOf) must
        // carry requiresApproval when created or when its amount changes.
        function approvalFlagOk() {
          let d = request.resource.data;
          return !(approvalNeeded(groupDoc(groupId).data, d.amount)
                   && (request.method == 'create' || d.amount != resource.data.amount))
            || d.get('requiresApproval', false) == true;
        }
        // A normal edit can't touch anyone's flag or the trash fields, and may only remove
        // approvals (the app clears them when the money changes); approving is its own write
        // (isFlagOrApproval). It may drop requiresApproval only when the new amount no longer
        // needs approval (at or below the threshold, or the group turned approval off): the
        // expense then counts at once.
        function trustFieldsKept() {
          let before = resource.data;
          let after = request.resource.data;
          let approvals = after.get('approvals', {}).diff(before.get('approvals', {}));
          return !after.diff(before).affectedKeys().hasAny(['dispute', 'deletedAt', 'deletedBy'])
            && approvals.changedKeys().size() == 0
            && approvals.addedKeys().size() == 0
            && (before.get('requiresApproval', false) != true || after.get('requiresApproval', false) == true
                || !approvalNeeded(groupDoc(groupId).data, after.amount));
        }
        // An amount change that still needs approval asks everyone again: approvals are reset to
        // at most the editor's own. Except when the group has edit auto-approve and the expense
        // was already marked: a change of at most editAutoApprove (either direction) keeps the
        // approvals and the mark as they are.
        function withinEditAutoApprove(g, before, after) {
          return 'editAutoApprove' in g
            && before.get('requiresApproval', false) == true
            && after.amount - before.amount <= g.editAutoApprove
            && before.amount - after.amount <= g.editAutoApprove;
        }
        function approvalsResetOk() {
          let g = groupDoc(groupId).data;
          let before = resource.data;
          let after = request.resource.data;
          return after.amount == before.amount
            || !approvalNeeded(g, after.amount)
            || withinEditAutoApprove(g, before, after)
            || after.get('approvals', {}).keys().hasOnly([uid()]);
        }
        // Flag / resolve / approve: only the caller's own key in `dispute` and `approvals`,
        // and nothing else in the document.
        function ownKeyOnly(field) {
          return request.resource.data.get(field, {}).diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
        }
        function validFlag(f) {
          return f.keys().hasOnly(['byUid', 'memberId', 'reason', 'at'])
            && f.byUid == uid()
            && f.reason is string && f.reason.size() > 0 && f.reason.size() <= 500
            && f.at is int
            && f.memberId is string
            // the flagger flags as themselves and is part of the expense
            && groupDoc(groupId).data.members[f.memberId].get('uid', '') == uid()
            && (f.memberId in resource.data.splits || f.memberId in resource.data.paidBy);
        }
        function isFlagOrApproval() {
          let after = request.resource.data;
          let flags = after.get('dispute', {});
          let approvals = after.get('approvals', {});
          return after.diff(resource.data).affectedKeys().hasOnly(['dispute', 'approvals'])
            && ownKeyOnly('dispute') && ownKeyOnly('approvals')
            && (!(uid() in flags) || validFlag(flags[uid()]))
            && (!(uid() in approvals) || approvals[uid()] == true);
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && validExpense() && noTrustFieldsOnCreate() && approvalFlagOk();
        allow update: if isGroupMember(groupId) && writesOpen()
          && ((validExpense() && trustFieldsKept() && approvalFlagOk() && approvalsResetOk()) || isTrashChange() || isFlagOrApproval());
        allow delete: if isGroupMember(groupId) && writesOpen() && canPurge();

        // Comment thread on an expense. Comments are immutable; only the author can
        // delete one, except that the group creator (who may purge any expense, comments
        // included, and delete the whole group) may delete any, and members may clean up
        // comments of an expense that is being deleted in the same batch (or is already gone).
        // The creator check reads only the group doc: deleting a big group's comments must
        // not need one existsAfter() per expense (rules allow 20 document reads per batch).
        match /comments/{commentId} {
          allow read: if isGroupMember(groupId);
          allow create: if isGroupMember(groupId) && writesOpen()
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
            && request.resource.data.authorUid == uid()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.authorName is string
            && request.resource.data.createdAt is int;
          allow update: if false;
          allow delete: if isUser() && writesOpen() && (resource.data.authorUid == uid()
            || (isGroupMember(groupId)
              && (groupDoc(groupId).data.createdBy == uid()
                || !existsAfter(/databases/$(database)/documents/groups/$(groupId)/expenses/$(expenseId)))));
        }
      }

      match /settlements/{settlementId} {
        function validSettlement() {
          return validAuthor()
            // Every field a payment may hold (src/types.ts Settlement); nothing else rides along.
            && request.resource.data.keys().hasOnly(['id', 'groupId', 'from', 'to', 'amount', 'method', 'note', 'date', 'createdBy',
                'createdAt', 'importedFrom', 'payLink', 'deletedAt', 'deletedBy'])
            && (!('payLink' in request.resource.data) || (request.resource.data.payLink is string && request.resource.data.payLink.size() <= 40))
            && request.resource.data.groupId == groupId
            && request.resource.data.amount is int
            && request.resource.data.amount > 0
            && (!('method' in request.resource.data) || (request.resource.data.method is string && request.resource.data.method.size() <= 40))
            && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
            && request.resource.data.from != request.resource.data.to
            && request.resource.data.from in groupDoc(groupId).data.members
            && request.resource.data.to in groupDoc(groupId).data.members;
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && validSettlement() && noTrustFieldsOnCreate();
        allow update: if isGroupMember(groupId) && writesOpen()
          && ((validSettlement() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt', 'deletedBy']))
              || isTrashChange());
        allow delete: if isGroupMember(groupId) && writesOpen() && canPurge();
      }

      // Append-only activity log (edit history, feed). Entries are written by members in the
      // same batch as the change they describe, as themselves, and never edited. The creator
      // may delete them only together with the group itself (group gone after the batch).
      match /activity/{activityId} {
        function validEntry(d) {
          return d.keys().hasAll(['type', 'actorUid', 'actorName', 'targetId', 'summary', 'createdAt'])
            && d.keys().hasOnly(['type', 'actorUid', 'actorName', 'targetId', 'summary', 'before', 'after', 'createdAt'])
            && d.actorUid == uid()
            // The kinds the app writes (src/types.ts ActivityType). `settlement.nudged` is the nudge
            // callable's alone (Admin SDK), so a client can't fake a push it never sent.
            && d.type in ['expense.created', 'expense.updated', 'expense.deleted', 'expense.restored', 'expense.purged',
                'expense.disputed', 'expense.resolved', 'expense.approved', 'expense.imported',
                'settlement.created', 'settlement.deleted', 'settlement.restored', 'settlement.purged',
                'member.added', 'member.removed']
            && d.actorName is string && d.actorName.size() <= 100
            && d.targetId is string && d.targetId.size() <= 200
            && d.summary is string && d.summary.size() <= 500
            && d.createdAt is int
            && (!('before' in d) || d.before is map)
            && (!('after' in d) || d.after is map);
        }
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && writesOpen() && validEntry(request.resource.data);
        allow update: if false;
        allow delete: if isUser() && writesOpen()
          && groupDoc(groupId).data.createdBy == uid()
          && !existsAfter(/databases/$(database)/documents/groups/$(groupId));
      }

      // Name + payment handles (+ profile photo URL) a member shares with this group only. Written by the owner
      // (also in the same batch as creating/joining the group, hence getAfter).
      match /profiles/{userId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isUser() && uid() == userId && writesOpen()
          && uid() in groupAfter(groupId).data.memberUids
          && request.resource.data.keys().hasOnly(['displayName', 'payment', 'photoURL'])
          && request.resource.data.displayName is string
          && (!('photoURL' in request.resource.data)
            || (request.resource.data.photoURL is string
              && request.resource.data.photoURL.size() <= 2048
              && request.resource.data.photoURL.matches('https://.+')));
        // the owner, or the group creator when removing the member / deleting the group
        allow delete: if isUser() && writesOpen() && (uid() == userId
          || (isGroupMember(groupId) && groupDoc(groupId).data.createdBy == uid()));
      }
    }

    // ---- Live table split ---------------------------------------------
    // tables/{code}: a bill everyone at the table claims items on, from their own phone.
    // The doc id is the share code (8 random chars), so knowing the code is what grants access;
    // there is no list. Guests sign in anonymously and their participant id is their uid.
    // Claims live at claims.{uid}.{itemId} = shares, so a guest's write can be confined to
    // their own key without iterating the items.
    match /tables/{code} {
      function isHost() { return signedIn() && resource.data.hostUid == uid(); }
      function isLive(t) { return t.status == 'open' && request.time.toMillis() < t.expiresAt; }
      function validParticipant(p, pid) {
        return p is map
          && p.keys().hasOnly(['name', 'uid', 'joinedAt'])
          && p.name is string && p.name.size() > 0 && p.name.size() <= 40
          && p.joinedAt is int
          && (!('uid' in p) || p.uid == pid);
      }
      // A guest may add/rename only their own participant entry and replace only their own claims.
      function isGuestUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let me = uid();
        let claimsAfter = after.get('claims', {});
        return signedIn()
          && isLive(before)
          && after.diff(before).affectedKeys().hasOnly(['participants', 'claims'])
          && after.participants.diff(before.participants).affectedKeys().hasOnly([me])
          && claimsAfter.diff(before.get('claims', {})).affectedKeys().hasOnly([me])
          // you must be at the table (after this write) and your entry carries your uid
          && me in after.participants
          && validParticipant(after.participants[me], me)
          && after.participants[me].uid == me
          && (!(me in claimsAfter)
            || (claimsAfter[me] is map
              && claimsAfter[me].size() <= 100
              && claimsAfter[me].keys().hasOnly(before.items.keys())));
      }

      // Anyone signed in (anonymous included) with the code can read an open, unexpired table;
      // the host and the people who joined can still read it after it closes (the summary).
      // A missing doc is readable so the host's client can check a fresh code is free.
      allow get: if signedIn() && (resource == null
        || resource.data.hostUid == uid()
        || isLive(resource.data)
        || uid() in resource.data.participants);
      allow list: if signedIn() && resource.data.hostUid == uid();
      allow create: if signedIn()
        && writesOpen()
        && request.resource.data.hostUid == uid()
        && request.resource.data.code == code
        && code.size() >= 6 && code.size() <= 12
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['code', 'groupId', 'hostUid', 'merchant', 'currency', 'date', 'items', 'extras',
          'participants', 'claims', 'hostPayment', 'status', 'createdAt', 'expiresAt', 'expenseId', 'closedGroupId'])
        && request.resource.data.items is map && request.resource.data.items.size() <= 200
        && request.resource.data.claims is map
        && request.resource.data.createdAt is int && request.resource.data.expiresAt is int
        && request.resource.data.createdAt <= request.time.toMillis() + 600000
        && request.resource.data.expiresAt - request.resource.data.createdAt <= 86400000
        && request.resource.data.participants[uid()].uid == uid();
      // The host can change anything except who hosts it, its code and when it expires.
      allow update: if writesOpen() && ((isHost()
          && request.resource.data.hostUid == resource.data.hostUid
          && request.resource.data.code == resource.data.code
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['open', 'closed'])
        || isGuestUpdate());
      allow delete: if isHost() && writesOpen();
    }

    // ---- Pay me links --------------------------------------------------
    // payLinks/{code}: a payee asks to be paid with a link that works without an account. The
    // code (20–40 random lowercase letters and digits) is the secret: anyone signed in, anonymous
    // included, may get a link they have the code for; nobody can list them. Only the payee
    // creates (for a debt in a group they are in, or a live table they host) or cancels one.
    // Anyone with the code may make exactly one change, while it is open and unexpired: open →
    // paid with paidAt, paidBy (themselves) and optionally method and a proof under
    // payproofs/{code}/. The onPayLinkPaid function records the settlement (Admin SDK).
    // It shows the payee's chosen handles (UPI ID, UPI number, PayID, PayPal, Revolut; never bank
    // account numbers) to anyone with the code: the owner accepted that (docs/PLAN.md §4.3).
    match /payLinks/{code} {
      function linkStr(d, k, max) { return d[k] is string && d[k].size() > 0 && d[k].size() <= max; }
      function linkOptStr(d, k, max) { return !(k in d) || linkStr(d, k, max); }
      function validHandles(h) {
        return h is map
          && h.keys().hasOnly(['upi', 'phone', 'payid', 'paypal', 'revolut'])
          && linkOptStr(h, 'upi', 100) && linkOptStr(h, 'phone', 100) && linkOptStr(h, 'payid', 100)
          && linkOptStr(h, 'paypal', 100) && linkOptStr(h, 'revolut', 100);
      }
      // The payee is the creator's own member entry in a group they belong to, owed by another member.
      function payeeInGroup(d) {
        let g = groupDoc(d.groupId).data;
        return uid() in g.memberUids
          && d.to in g.members && g.members[d.to].get('uid', '') == uid()
          && d.from in g.members
          && d.currency == g.currency;
      }
      // A live table closed without a group: the host is the payee, the debtor one of its people.
      function hostOfTable(d) {
        let t = get(/databases/$(database)/documents/tables/$(d.tableCode)).data;
        return t.hostUid == uid() && d.to == uid() && d.from in t.participants;
      }
      function validNewLink(d) {
        let now = request.time.toMillis();
        return d.keys().hasAll(['groupName', 'from', 'to', 'amount', 'currency', 'payeeName', 'payerName', 'payment',
            'createdBy', 'createdAt', 'expiresAt', 'status'])
          && d.keys().hasOnly(['groupId', 'groupName', 'emoji', 'tableCode', 'from', 'to', 'amount', 'currency', 'payeeName', 'payerName',
            'payment', 'forUid', 'createdBy', 'createdAt', 'expiresAt', 'status'])
          && d.createdBy == uid()
          && d.status == 'open'
          && d.amount is int && d.amount > 0 && d.amount <= 100000000000
          && d.currency is string && d.currency.size() == 3
          && linkStr(d, 'from', 64) && linkStr(d, 'to', 128) && d.from != d.to
          && linkStr(d, 'groupName', 80) && linkStr(d, 'payeeName', 80) && linkStr(d, 'payerName', 80)
          && linkOptStr(d, 'emoji', 16) && linkOptStr(d, 'forUid', 128) && linkOptStr(d, 'tableCode', 12)
          && validHandles(d.payment)
          && d.createdAt is int && d.createdAt > now - 600000 && d.createdAt < now + 600000
          && d.expiresAt is int && d.expiresAt > d.createdAt && d.expiresAt - d.createdAt <= 2678400000
          && (('groupId' in d && linkStr(d, 'groupId', 64) && payeeInGroup(d))
            || (!('groupId' in d) && 'tableCode' in d && hostOfTable(d)));
      }
      // "I've paid": the only change someone other than the payee may make, once.
      function isPaidClaim() {
        let before = resource.data;
        let after = request.resource.data;
        let now = request.time.toMillis();
        return signedIn()
          && before.status == 'open'
          && now < before.expiresAt
          && after.status == 'paid'
          && after.diff(before).affectedKeys().hasOnly(['status', 'paidAt', 'paidBy', 'method', 'proofPath', 'settlementId'])
          && after.paidAt is int && after.paidAt > now - 600000 && after.paidAt < now + 600000
          && after.paidBy == uid()
          && (!('forUid' in before) || before.forUid == uid())
          && linkOptStr(after, 'method', 40)
          && (!('proofPath' in after) || (after.proofPath is string
            && after.proofPath.matches('payproofs/' + code + '/[A-Za-z0-9_-]{1,64}[.]jpg')))
          // A member who recorded the payment in Settle up says which settlement cleared it.
          && (!('settlementId' in after) || (isUser() && 'groupId' in before
            && uid() in groupDoc(before.groupId).data.memberUids
            && linkStr(after, 'settlementId', 64)));
      }
      function isCancel() {
        return isUser()
          && resource.data.createdBy == uid()
          && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.resource.data.cancelledAt is int;
      }
      allow get: if signedIn();
      allow list: if false;
      allow create: if isUser() && writesOpen()
        && code.size() >= 20 && code.size() <= 40 && code.matches('[a-z0-9]+')
        && validNewLink(request.resource.data);
      allow update: if writesOpen() && (isPaidClaim() || isCancel());
      allow delete: if isUser() && writesOpen() && resource.data.createdBy == uid();
    }

    // ---- Invites -------------------------------------------------------
    // Lookup table for signed-in users: code → group name + unclaimed placeholders.
    // An invite can only point at a group whose inviteCode is this doc's id, written by
    // a member of that group (after the batch, so create-group / join can include it).
    match /invites/{code} {
      function validInvite() {
        let g = groupAfter(request.resource.data.groupId);
        return isUser()
          && code.size() >= 8
          && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'emoji', 'placeholders'])
          && request.resource.data.groupId is string
          && (!('groupName' in request.resource.data) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 80))
          && (!('placeholders' in request.resource.data) || (request.resource.data.placeholders is map && request.resource.data.placeholders.size() <= 60))
          && g != null
          && g.data.inviteCode == code
          && uid() in g.data.memberUids;
      }
      // Someone leaving a group (a member before the batch, not after) may tidy the invite in
      // the same batch, but only by removing placeholder entries: nothing is added or renamed.
      function isLeaverCleanup() {
        let before = resource.data;
        let after = request.resource.data;
        let ph = after.get('placeholders', {}).diff(before.get('placeholders', {}));
        return isUser()
          && after.groupId == before.groupId
          && after.diff(before).affectedKeys().hasOnly(['placeholders'])
          && ph.addedKeys().size() == 0
          && ph.changedKeys().size() == 0
          && uid() in groupDoc(before.groupId).data.memberUids
          && !(uid() in groupAfter(before.groupId).data.memberUids);
      }
      allow get: if isUser();
      allow list: if false;
      allow create: if validInvite() && writesOpen();
      allow update: if writesOpen() && ((validInvite() && request.resource.data.groupId == resource.data.groupId) || isLeaverCleanup());
      allow delete: if isUser() && writesOpen() && isGroupMember(resource.data.groupId)
        && groupDoc(resource.data.groupId).data.inviteCode == code;
    }
  }
}
