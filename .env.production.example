# Firebase web config for production builds (`npm run build`, `npm run deploy`). Copy this file to
# `.env.production` (gitignored) and fill in your project's values from Firebase console → Project
# settings → Your apps. The web API key is visible to anyone who loads the site, so restrict it in
# Google Cloud → Credentials (websites + APIs, docs/FIREBASE_SETUP.md); keeping it out of git still
# stops it being scraped from the repository and lets each fork use its own project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false

# FCM Web Push (VAPID) public key — Project settings → Cloud Messaging → Web Push certificates. Public by design.
VITE_FCM_VAPID_KEY=

# App Check (reCAPTCHA Enterprise / Fraud Defense) site key. Public by design.
# Enforcement is OFF in the console (monitor mode) until metrics show ~100% verified traffic.
VITE_APPCHECK_SITE_KEY=

# Shared iPhone Shortcut "Split Now SMS" (asks for the key on import; filters OTP/non-debit SMS on the phone)
VITE_IOS_SHORTCUT_URL=
