{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "../shared/sms-parse.ts",
    "../shared/capture-filters.ts",
    "../shared/ai-config.ts",
    "../shared/quick-ai.ts",
    "../shared/money-core.ts",
    "../shared/trips.ts",
    "../shared/balances-core.ts",
    "../shared/members.ts",
    "../shared/paylinks.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
