# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these empty to run in local DEMO MODE (data stored in your browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" to point the app at the local Firebase emulators.
VITE_USE_EMULATORS=false

# SMS auto-capture (optional): iCloud link to the shared Shortcut, and an exported MacroDroid template
VITE_IOS_SHORTCUT_URL=
VITE_ANDROID_MACRO_URL=
# FCM Web Push public (VAPID) key
VITE_FCM_VAPID_KEY=
# App Check (reCAPTCHA Enterprise site key). Leave empty to disable. Debug token: local dev only.
VITE_APPCHECK_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
